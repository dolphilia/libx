{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "snapshotVersion", "fetchBatches", "batches"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "snapshotVersion": { "type": "string" },
    "fetchBatches": { "type": "array" },
    "batches": { "type": "array", "items": { "$ref": "#/$defs/pipelineBatch" } }
  },
  "$defs": {
    "state": { "enum": ["pending", "completed"] },
    "pipelineBatch": {
      "type": "object",
      "required": [
        "batchNumber",
        "sourceIds",
        "discovered",
        "locked",
        "normalized",
        "canonical-validated",
        "translated",
        "translation-validated",
        "human-reviewed",
        "inputHash",
        "outputHash",
        "checks",
        "pages"
      ],
      "properties": {
        "batchNumber": { "type": "integer", "minimum": 1 },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "type": "string" }
        },
        "discovered": { "$ref": "#/$defs/state" },
        "locked": { "$ref": "#/$defs/state" },
        "normalized": { "$ref": "#/$defs/state" },
        "canonical-validated": { "$ref": "#/$defs/state" },
        "translated": { "$ref": "#/$defs/state" },
        "translation-validated": { "$ref": "#/$defs/state" },
        "human-reviewed": { "$ref": "#/$defs/state" },
        "inputHash": { "type": "string" },
        "outputHash": { "type": "string" },
        "checks": { "type": "array", "items": { "type": "string" } },
        "pages": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
