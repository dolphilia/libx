    "sources": [
      {
        "id": "gnu-time-manual",
        "name": "GNU Time 1.10 manual, Overview and complete chapters 1–2",
        "author": "David MacKenzie / Free Software Foundation",
        "license": "GFDL1.3-or-later",
        "licenseUrl": "/docs/gnu-time/source/v1-10/manual.html#GNU-Free-Documentation-License",
        "sourceUrl": "https://www.gnu.org/software/gzip/manual/",
        "provenanceNotes": [
          {
            "en": "This unofficial Libx guide includes the complete overview and chapters 1–2 of GNU Time 1.10. The original English license is retained; the concept index is available in the fixed complete original manual, Info and Texinfo originals. Examples and reported values are original static samples, not Libx measurements. Program output and shell comments are retained; the comments distinguish bash/ksh from csh/tcsh.",
            "ja": "Libxによる非公式ガイドです。GNU Time 1.10の原文概要・通知と第1〜2章全文を提供します。原英語のライセンスを保持し、概念索引は固定全文の英語マニュアル・Info・Texinfo原稿で参照できます。例と測定値は原著の静的な例で、Libxの実測値ではありません。プログラム出力と短いシェルコメントは原文保持です。例のコメントはbash/kshの場合とcsh/tcshの場合を区別しています。"
          },
          {
            "en": "Original copyright, permission, author, publisher, History and the whole original English GFDL are retained below. There are no Invariant Sections or Cover Texts.",
            "ja": "原著作権・許諾・著作者・発行者・履歴・原英語GFDL全文を以下に保持しています。不変節・表紙文言はありません。"
          },
          {
            "en": "The document revision is 13 February 2026; the release date is 14 April 2026; the site date is acquisition 6 October 2026. Source fixed to the 1.10 archive SHA256 706bf7b8444ca9eb9037e9eda18e1d0eb7c2327ae7d8c2ce3a4823c5f80c7b11. Original sources are unmodified.",
            "ja": "文書改訂日は2026年2月13日、リリース日は2026年4月14日、サイト版の日付は取得日の2026年10月6日です。原著1.10配布物SHA256 706bf7b8444ca9eb9037e9eda18e1d0eb7c2327ae7d8c2ce3a4823c5f80c7b11に固定しています。原著ソースは変更していません。"
          }
        ],
