        },
        "end": {
          "line": 22,
          "column": 93,
          "offset": 1588
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "To register manually created loggers(i.e. not created by the spdlog.h factory functions) use the ",
          "position": {
            "start": {
              "line": 24,
              "column": 1,
              "offset": 1590
            },
            "end": {
              "line": 24,
              "column": 98,
              "offset": 1687
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "register_logger(std::shared_ptr<logger>)",
          "position": {
            "start": {
              "line": 24,
              "column": 98,
              "offset": 1687
            },
            "end": {
              "line": 24,
              "column": 144,
              "offset": 1733
            }
          }
        },
        {
          "type": "text",
          "value": " function:",
          "position": {
