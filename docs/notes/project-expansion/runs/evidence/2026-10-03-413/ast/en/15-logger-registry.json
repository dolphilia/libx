          "offset": 1020
        },
        "end": {
          "line": 5,
          "column": 73,
          "offset": 1092
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "The purpose is for loggers to be accessed easily from anywhere in the project without passing them around.",
          "position": {
            "start": {
              "line": 7,
              "column": 1,
              "offset": 1094
            },
            "end": {
