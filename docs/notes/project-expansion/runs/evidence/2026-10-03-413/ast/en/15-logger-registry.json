        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "Normally  there is no need to register loggers as they are registered automatically for you.",
          "position": {
            "start": {
              "line": 22,
              "column": 1,
              "offset": 1496
            },
            "end": {
              "line": 22,
              "column": 93,
              "offset": 1588
