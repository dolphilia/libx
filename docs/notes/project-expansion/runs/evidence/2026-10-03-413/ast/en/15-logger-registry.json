  "children": [
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "spdlog maintains a global (per process) registry of the created loggers.",
          "position": {
            "start": {
              "line": 5,
              "column": 1,
              "offset": 1020
            },
            "end": {
              "line": 5,
              "column": 73,
              "offset": 1092
            }
          }
        }
      ],
      "position": {
