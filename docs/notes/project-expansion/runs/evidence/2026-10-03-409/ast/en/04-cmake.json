        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "Below is an example on to configure and build spdlog using the Android NDK:",
          "position": {
            "start": {
              "line": 62,
              "column": 1,
              "offset": 3630
            },
            "end": {
              "line": 62,
              "column": 76,
              "offset": 3705
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 62,
          "column": 1,
          "offset": 3630
        },
        "end": {
          "line": 62,
          "column": 76,
          "offset": 3705
        }
      }
    },
    {
      "type": "code",
      "lang": "bash",
      "meta": null,
      "value": "> git clone https://github.com/gabime/spdlog\n> mkdir build\n> cd build \n> cmake ../spdlog \\\n  -DCMAKE_SYSTEM_NAME=Android \\\n  -DCMAKE_SYSTEM_VERSION=21 \\\n  -DCMAKE_ANDROID_ARCH_ABI=\"armeabi-v7a\" \\\n  -DCMAKE_ANDROID_ARM_NEON=ON \\\n  -DCMAKE_ANDROID_NDK=$HOME/Android/Ndk/android-ndk-r13b/\n> cmake --build .",
      "position": {
        "start": {
          "line": 63,
          "column": 1,
          "offset": 3706
        },
        "end": {
          "line": 74,
          "column": 4,
          "offset": 4021
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
