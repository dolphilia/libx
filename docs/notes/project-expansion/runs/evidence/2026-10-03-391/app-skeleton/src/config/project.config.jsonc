{
  "paths": {
    "baseUrlPrefix": "/docs",
    "projectSlug": "spdlog",
    "siteUrl": "https://libx.dev"
  },
  // 言語設定（対応言語・デフォルト・表示名）
  "language": {
    "default": "en",
    "supported": [
      "en",
      "ja"
    ],
    "displayNames": {
      "en": "English",
      "ja": "日本語"
    }
  },
  // 各言語の表示情報とカテゴリ名
  "translations": {
    "en": {
      "displayName": "spdlog",
      "displayDescription": "Unofficial presentation and Japanese translation of the spdlog 1.17.0 README and the official Wiki snapshot of 2025-10-15",
      "categories": {
        "guide": "Guide",
        "reference": "Sources and license"
      }
    },
    "ja": {
      "displayName": "spdlog",
      "displayDescription": "spdlog 1.17.0 READMEと公式Wiki 2025-10-15固定版の非公式日本語訳",
      "categories": {
        "guide": "ガイド",
        "reference": "出典・ライセンス"
      }
    }
  },
  // バージョン管理
  "versioning": {
    "versions": [
      {
        "id": "v1-17-0",
        "name": "1.17.0 / Wiki 2025-10-15",
        "date": "2026-01-04T00:00:00.000Z",
        "isLatest": true
      }
    ]
  },
  // ライセンス情報
  "licensing": {
    "defaultSource": "spdlog-readme",
    "showAttribution": true,
    "sourceLanguage": "en",
    "sources": [
