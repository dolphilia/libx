    },
    {
      "index": 136,
      "en": "buffer",
      "ja": "buffer"
    },
    {
      "index": 137,
      "en": " will contain the path and ",
      "ja": "にパスが入り、"
    },
    {
      "index": 138,
      "en": "size",
      "ja": "size"
    },
    {
      "index": 139,
