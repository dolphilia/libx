      "index": 141,
      "en": " will be returned and ",
      "ja": "を返し、"
    },
    {
      "index": 142,
      "en": "size",
      "ja": "size"
    },
    {
      "index": 143,
      "en": " will be set to\nthe required size, including the null terminator.",
