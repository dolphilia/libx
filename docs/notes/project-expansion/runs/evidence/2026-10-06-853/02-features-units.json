[
  {
    "n": 1,
    "text": "\nGeneral"
  },
  {
    "n": 2,
    "text": "Cross-platform"
  },
  {
    "n": 3,
    "text": "Compilers: Visual Studio, gcc, clang, etc."
  },
  {
    "n": 4,
    "text": "Architectures: x86, x64, ARM, etc."
  },
  {
    "n": 5,
    "text": "Operating systems: Windows, Mac OS X, Linux, iOS, Android, etc."
  },
  {
    "n": 6,
    "text": "Easy installation"
  },
  {
    "n": 7,
    "text": "Header files only library. Just copy the headers to your project."
  },
  {
    "n": 8,
    "text": "Self-contained, minimal dependences"
  },
  {
    "n": 9,
    "text": "No STL, BOOST, etc."
  },
  {
    "n": 10,
    "text": "Only included "
  },
  {
    "n": 11,
    "text": "<cstdio>"
  },
  {
    "n": 12,
    "text": ", "
  },
  {
    "n": 13,
    "text": "<cstdlib>"
  },
  {
    "n": 14,
    "text": ", "
  },
  {
    "n": 15,
    "text": "<cstring>"
  },
  {
    "n": 16,
    "text": ", "
  },
  {
    "n": 17,
    "text": "<inttypes.h>"
  },
  {
    "n": 18,
    "text": ", "
  },
  {
    "n": 19,
    "text": "<new>"
  },
  {
    "n": 20,
    "text": ", "
  },
  {
    "n": 21,
    "text": "<stdint.h>"
  },
  {
    "n": 22,
    "text": "."
  },
  {
    "n": 23,
    "text": "Without C++ exception, RTTI"
  },
  {
    "n": 24,
    "text": "High performance"
  },
  {
    "n": 25,
    "text": "Use template and inline functions to reduce function call overheads."
  },
  {
    "n": 26,
    "text": "Internal optimized Grisu2 and floating point parsing implementations."
  },
  {
    "n": 27,
    "text": "Optional SSE2/SSE4.2 support."
  },
  {
    "n": 28,
    "text": "\nStandard compliance"
  },
  {
    "n": 29,
    "text": "RapidJSON should be fully RFC4627/ECMA-404 compliance."
  },
  {
    "n": 30,
    "text": "Support JSON Pointer (RFC6901)."
  },
  {
    "n": 31,
    "text": "Support JSON Schema Draft v4."
  },
  {
    "n": 32,
    "text": "Support Unicode surrogate."
  },
  {
    "n": 33,
    "text": "Support null character ("
  },
  {
    "n": 34,
    "text": "\"\\u0000\""
  },
  {
    "n": 35,
    "text": ")"
  },
  {
    "n": 36,
    "text": "For example, "
  },
  {
    "n": 37,
    "text": "[\"Hello\\u0000World\"]"
  },
  {
    "n": 38,
    "text": " can be parsed and handled gracefully. There is API for getting/setting lengths of string."
  },
  {
    "n": 39,
    "text": "Support optional relaxed syntax."
  },
  {
    "n": 40,
    "text": "Single line ("
  },
  {
    "n": 41,
    "text": "// ..."
  },
  {
    "n": 42,
    "text": ") and multiple line ("
  },
  {
    "n": 43,
    "text": "/* ... */"
  },
  {
    "n": 44,
    "text": ") comments ("
  },
  {
    "n": 45,
    "text": "kParseCommentsFlag"
  },
  {
    "n": 46,
    "text": ")."
  },
  {
    "n": 47,
    "text": "Trailing commas at the end of objects and arrays ("
  },
  {
    "n": 48,
    "text": "kParseTrailingCommasFlag"
  },
  {
    "n": 49,
    "text": ")."
  },
  {
    "n": 50,
    "text": "NaN"
  },
  {
    "n": 51,
    "text": ", "
  },
  {
    "n": 52,
    "text": "Inf"
  },
  {
    "n": 53,
    "text": ", "
  },
  {
    "n": 54,
    "text": "Infinity"
  },
  {
    "n": 55,
    "text": ", "
  },
  {
    "n": 56,
    "text": "-Inf"
  },
  {
    "n": 57,
    "text": " and "
  },
  {
    "n": 58,
    "text": "-Infinity"
  },
  {
    "n": 59,
    "text": " as "
  },
  {
    "n": 60,
    "text": "double"
  },
  {
    "n": 61,
    "text": " values ("
  },
  {
    "n": 62,
    "text": "kParseNanAndInfFlag"
  },
  {
    "n": 63,
    "text": ")"
  },
  {
    "n": 64,
    "text": "NPM compliant"
  },
  {
    "n": 65,
    "text": "."
  },
  {
    "n": 66,
    "text": "\nUnicode"
  },
  {
    "n": 67,
    "text": "Support UTF-8, UTF-16, UTF-32 encodings, including little endian and big endian."
  },
  {
    "n": 68,
    "text": "These encodings are used in input/output streams and in-memory representation."
  },
  {
    "n": 69,
    "text": "Support automatic detection of encodings in input stream."
  },
  {
    "n": 70,
    "text": "Support transcoding between encodings internally."
  },
  {
    "n": 71,
    "text": "For example, you can read a UTF-8 file and let RapidJSON transcode the JSON strings into UTF-16 in the DOM."
  },
  {
    "n": 72,
    "text": "Support encoding validation internally."
  },
  {
    "n": 73,
    "text": "For example, you can read a UTF-8 file, and let RapidJSON check whether all JSON strings are valid UTF-8 byte sequence."
  },
  {
    "n": 74,
    "text": "Support custom character types."
  },
  {
    "n": 75,
    "text": "By default the character types are "
  },
  {
    "n": 76,
    "text": "char"
  },
  {
    "n": 77,
    "text": " for UTF8, "
  },
  {
    "n": 78,
    "text": "wchar_t"
  },
  {
    "n": 79,
    "text": " for UTF16, "
  },
  {
    "n": 80,
    "text": "uint32_t"
  },
  {
    "n": 81,
    "text": " for UTF32."
  },
  {
    "n": 82,
    "text": "Support custom encodings."
  },
  {
    "n": 83,
    "text": "\nAPI styles"
  },
  {
    "n": 84,
    "text": "SAX (Simple API for XML) style API"
  },
  {
    "n": 85,
    "text": "Similar to "
  },
  {
    "n": 86,
    "text": "SAX"
  },
  {
    "n": 87,
    "text": ", RapidJSON provides a event sequential access parser API ("
  },
  {
    "n": 88,
    "text": "rapidjson::GenericReader"
  },
  {
    "n": 89,
    "text": "). It also provides a generator API ("
  },
  {
    "n": 90,
    "text": "rapidjson::Writer"
  },
  {
    "n": 91,
    "text": ") which consumes the same set of events."
  },
  {
    "n": 92,
    "text": "DOM (Document Object Model) style API"
  },
  {
    "n": 93,
    "text": "Similar to "
  },
  {
    "n": 94,
    "text": "DOM"
  },
  {
    "n": 95,
    "text": " for HTML/XML, RapidJSON can parse JSON into a DOM representation ("
  },
  {
    "n": 96,
    "text": "rapidjson::GenericDocument"
  },
  {
    "n": 97,
    "text": "), for easy manipulation, and finally stringify back to JSON if needed."
  },
  {
    "n": 98,
    "text": "The DOM style API ("
  },
  {
    "n": 99,
    "text": "rapidjson::GenericDocument"
  },
  {
    "n": 100,
    "text": ") is actually implemented with SAX style API ("
  },
  {
    "n": 101,
    "text": "rapidjson::GenericReader"
  },
  {
    "n": 102,
    "text": "). SAX is faster but sometimes DOM is easier. Users can pick their choices according to scenarios."
  },
  {
    "n": 103,
    "text": "\nParsing"
  },
  {
    "n": 104,
    "text": "Recursive (default) and iterative parser"
  },
  {
    "n": 105,
    "text": "Recursive parser is faster but prone to stack overflow in extreme cases."
  },
  {
    "n": 106,
    "text": "Iterative parser use custom stack to keep parsing state."
  },
  {
    "n": 107,
    "text": "Support "
  },
  {
    "n": 108,
    "text": "in situ"
  },
  {
    "n": 109,
    "text": " parsing."
  },
  {
    "n": 110,
    "text": "Parse JSON string values in-place at the source JSON, and then the DOM points to addresses of those strings."
  },
  {
    "n": 111,
    "text": "Faster than convention parsing: no allocation for strings, no copy (if string does not contain escapes), cache-friendly."
  },
  {
    "n": 112,
    "text": "Support 32-bit/64-bit signed/unsigned integer and "
  },
  {
    "n": 113,
    "text": "double"
  },
  {
    "n": 114,
    "text": " for JSON number type."
  },
  {
    "n": 115,
    "text": "Support parsing multiple JSONs in input stream ("
  },
  {
    "n": 116,
    "text": "kParseStopWhenDoneFlag"
  },
  {
    "n": 117,
    "text": ")."
  },
  {
    "n": 118,
    "text": "Error Handling"
  },
  {
    "n": 119,
    "text": "Support comprehensive error code if parsing failed."
  },
  {
    "n": 120,
    "text": "Support error message localization."
  },
  {
    "n": 121,
    "text": "\nDOM (Document)"
  },
  {
    "n": 122,
    "text": "RapidJSON checks range of numerical values for conversions."
  },
  {
    "n": 123,
    "text": "Optimization for string literal"
  },
  {
    "n": 124,
    "text": "Only store pointer instead of copying"
  },
  {
    "n": 125,
    "text": "Optimization for \"short\" strings"
  },
  {
    "n": 126,
    "text": "Store short string in "
  },
  {
    "n": 127,
    "text": "Value"
  },
  {
    "n": 128,
    "text": " internally without additional allocation."
  },
  {
    "n": 129,
    "text": "For UTF-8 string: maximum 11 characters in 32-bit, 21 characters in 64-bit (13 characters in x86-64)."
  },
  {
    "n": 130,
    "text": "Optionally support "
  },
  {
    "n": 131,
    "text": "std::string"
  },
  {
    "n": 132,
    "text": " (define "
  },
  {
    "n": 133,
    "text": "RAPIDJSON_HAS_STDSTRING"
  },
  {
    "n": 134,
    "text": "=1"
  },
  {
    "n": 135,
    "text": ")"
  },
  {
    "n": 136,
    "text": "\nGeneration"
  },
  {
    "n": 137,
    "text": "Support "
  },
  {
    "n": 138,
    "text": "rapidjson::PrettyWriter"
  },
  {
    "n": 139,
    "text": " for adding newlines and indentations."
  },
  {
    "n": 140,
    "text": "\nStream"
  },
  {
    "n": 141,
    "text": "Support "
  },
  {
    "n": 142,
    "text": "rapidjson::GenericStringBuffer"
  },
  {
    "n": 143,
    "text": " for storing the output JSON as string."
  },
  {
    "n": 144,
    "text": "Support "
  },
  {
    "n": 145,
    "text": "rapidjson::FileReadStream"
  },
  {
    "n": 146,
    "text": " and "
  },
  {
    "n": 147,
    "text": "rapidjson::FileWriteStream"
  },
  {
    "n": 148,
    "text": " for input/output "
  },
  {
    "n": 149,
    "text": "FILE"
  },
  {
    "n": 150,
    "text": " object."
  },
  {
    "n": 151,
    "text": "Support custom streams."
  },
  {
    "n": 152,
    "text": "\nMemory"
  },
  {
    "n": 153,
    "text": "Minimize memory overheads for DOM."
  },
  {
    "n": 154,
    "text": "Each JSON value occupies exactly 16/20 bytes for most 32/64-bit machines (excluding text string)."
  },
  {
    "n": 155,
    "text": "Support fast default allocator."
  },
  {
    "n": 156,
    "text": "A stack-based allocator (allocate sequentially, prohibit to free individual allocations, suitable for parsing)."
  },
  {
    "n": 157,
    "text": "User can provide a pre-allocated buffer. (Possible to parse a number of JSONs without any CRT allocation)"
  },
  {
    "n": 158,
    "text": "Support standard CRT(C-runtime) allocator."
  },
  {
    "n": 159,
    "text": "Support custom allocators."
  },
  {
    "n": 160,
    "text": "\nMiscellaneous"
  },
  {
    "n": 161,
    "text": "Some C++11 support (optional)"
  },
  {
    "n": 162,
    "text": "Rvalue reference"
  },
  {
    "n": 163,
    "text": "noexcept"
  },
  {
    "n": 164,
    "text": " specifier"
  },
  {
    "n": 165,
    "text": "Range-based for loop "
  }
]
