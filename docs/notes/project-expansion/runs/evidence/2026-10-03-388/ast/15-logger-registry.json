        },
        "end": {
          "line": 5,
          "column": 73,
          "offset": 520
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "The purpose is for loggers to be accessed easily from anywhere in the project without passing them around.",
