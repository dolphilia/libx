    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "Cross-compiling with CMake is reported working using CMake version 3.7 which includes native support for configuring the toolchain with Android NDK and SDK (",
          "position": {
            "start": {
              "line": 60,
              "column": 1,
              "offset": 2372
            },
            "end": {
              "line": 60,
              "column": 158,
              "offset": 2529
            }
          }
        },
        {
          "type": "link",
          "title": null,
          "url": "https://cmake.org/cmake/help/v3.7/manual/cmake-toolchains.7.html#cross-compiling-for-android",
          "children": [
            {
              "type": "text",
              "value": "https://cmake.org/cmake/help/v3.7/manual/cmake-toolchains.7.html#cross-compiling-for-android",
              "position": {
                "start": {
                  "line": 60,
                  "column": 158,
                  "offset": 2529
                },
                "end": {
                  "line": 60,
                  "column": 250,
                  "offset": 2621
                }
              }
            }
          ],
          "position": {
            "start": {
              "line": 60,
              "column": 158,
              "offset": 2529
            },
            "end": {
              "line": 60,
              "column": 250,
              "offset": 2621
            }
          }
        },
        {
          "type": "text",
          "value": "). Please note that spdlog targets older versions of CMake and this example is a community contribution.",
          "position": {
            "start": {
              "line": 60,
              "column": 250,
              "offset": 2621
            },
            "end": {
              "line": 60,
              "column": 354,
              "offset": 2725
            }
