    "slug": "10-flush-policy",
    "trial": "/private/tmp/libx-spdlog-trial-20261003/apps/spdlog-trial/src/content/docs/v1/en/01-guide/10-flush-policy.md",
    "bytes": 1689,
    "wholeBodyKept": true
  },
  "children": [
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "By default spdlog lets the underlying libc flush whenever it sees fit in order to achieve good performance. You can override this using the following options:",
          "position": {
            "start": {
              "line": 5,
              "column": 1,
              "offset": 445
            },
            "end": {
              "line": 5,
              "column": 159,
              "offset": 603
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 5,
          "column": 1,
          "offset": 445
        },
        "end": {
          "line": 5,
          "column": 159,
          "offset": 603
        }
      }
    },
    {
      "type": "heading",
      "depth": 3,
      "children": [
        {
          "type": "text",
          "value": "Manual flush",
          "position": {
            "start": {
              "line": 8,
              "column": 5,
              "offset": 610
            },
            "end": {
              "line": 8,
              "column": 17,
              "offset": 622
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 8,
          "column": 1,
          "offset": 606
        },
        "end": {
          "line": 8,
          "column": 17,
          "offset": 622
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "You can use the ",
          "position": {
            "start": {
              "line": 9,
              "column": 1,
              "offset": 623
            },
            "end": {
              "line": 9,
              "column": 17,
              "offset": 639
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "logger->flush()",
          "position": {
            "start": {
              "line": 9,
              "column": 17,
              "offset": 639
            },
            "end": {
              "line": 9,
              "column": 38,
              "offset": 660
            }
          }
        },
        {
          "type": "text",
          "value": " function to instruct a logger to flush its contents. The logger will in turn call the ",
          "position": {
            "start": {
              "line": 9,
              "column": 38,
              "offset": 660
            },
            "end": {
              "line": 9,
              "column": 125,
              "offset": 747
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "flush()",
          "position": {
            "start": {
              "line": 9,
              "column": 125,
              "offset": 747
            },
            "end": {
              "line": 9,
              "column": 138,
              "offset": 760
            }
          }
        },
        {
          "type": "text",
          "value": " function on each of the underlying sinks.",
          "position": {
            "start": {
              "line": 9,
              "column": 138,
              "offset": 760
            },
            "end": {
              "line": 9,
              "column": 180,
              "offset": 802
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 9,
          "column": 1,
          "offset": 623
        },
        "end": {
          "line": 9,
          "column": 180,
          "offset": 802
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "strong",
          "children": [
            {
              "type": "text",
              "value": "Note:",
              "position": {
                "start": {
                  "line": 11,
                  "column": 3,
                  "offset": 806
                },
                "end": {
                  "line": 11,
                  "column": 8,
                  "offset": 811
                }
              }
            }
          ],
          "position": {
            "start": {
              "line": 11,
              "column": 1,
              "offset": 804
            },
            "end": {
              "line": 11,
              "column": 10,
              "offset": 813
            }
          }
        },
        {
          "type": "text",
          "value": " If using an async logger, ",
          "position": {
            "start": {
              "line": 11,
              "column": 10,
              "offset": 813
            },
            "end": {
              "line": 11,
              "column": 37,
              "offset": 840
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "logger->flush()",
          "position": {
            "start": {
              "line": 11,
              "column": 37,
              "offset": 840
            },
            "end": {
              "line": 11,
              "column": 58,
              "offset": 861
            }
          }
        },
        {
          "type": "text",
          "value": " posts a message to the queue requesting the flush operation, so the function returns immediately. This is different from some older versions of spdlog (which would synchronously wait until the message was received and the flush completed). Currently there is no need to explicitly call ",
          "position": {
            "start": {
              "line": 11,
              "column": 58,
              "offset": 861
            },
            "end": {
              "line": 11,
              "column": 345,
              "offset": 1148
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "logger->flush()",
          "position": {
            "start": {
              "line": 11,
              "column": 345,
              "offset": 1148
            },
            "end": {
              "line": 11,
              "column": 366,
              "offset": 1169
            }
          }
        },
        {
          "type": "text",
          "value": "  or ",
          "position": {
            "start": {
              "line": 11,
              "column": 366,
              "offset": 1169
            },
            "end": {
              "line": 11,
              "column": 371,
              "offset": 1174
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "spdlog::shutdown()",
          "position": {
            "start": {
              "line": 11,
              "column": 371,
              "offset": 1174
            },
            "end": {
              "line": 11,
              "column": 395,
              "offset": 1198
            }
          }
        },
        {
          "type": "text",
          "value": " before shutting down, it is done automatically at destruction while program exits. However, if you want to flush all the async logger manually before  \"immediately\" exit function such as ",
          "position": {
            "start": {
              "line": 11,
              "column": 395,
              "offset": 1198
            },
            "end": {
              "line": 11,
              "column": 583,
              "offset": 1386
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "abort()",
          "position": {
            "start": {
              "line": 11,
              "column": 583,
              "offset": 1386
            },
            "end": {
              "line": 11,
              "column": 596,
              "offset": 1399
            }
          }
        },
        {
          "type": "text",
          "value": " or ",
          "position": {
            "start": {
              "line": 11,
              "column": 596,
              "offset": 1399
            },
            "end": {
              "line": 11,
              "column": 600,
              "offset": 1403
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "_exit(-1)",
          "position": {
            "start": {
              "line": 11,
              "column": 600,
              "offset": 1403
            },
            "end": {
              "line": 11,
              "column": 615,
              "offset": 1418
            }
          }
        },
        {
          "type": "text",
          "value": ", please call ",
          "position": {
            "start": {
              "line": 11,
              "column": 615,
              "offset": 1418
            },
            "end": {
              "line": 11,
              "column": 629,
              "offset": 1432
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "spdlog::shutdown()",
          "position": {
            "start": {
              "line": 11,
              "column": 629,
              "offset": 1432
            },
            "end": {
              "line": 11,
              "column": 653,
              "offset": 1456
            }
          }
        },
        {
          "type": "text",
          "value": " before those functions.",
          "position": {
            "start": {
              "line": 11,
              "column": 653,
              "offset": 1456
            },
            "end": {
              "line": 11,
              "column": 677,
              "offset": 1480
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 11,
          "column": 1,
          "offset": 804
        },
        "end": {
          "line": 11,
          "column": 677,
          "offset": 1480
        }
      }
    },
    {
      "type": "heading",
      "depth": 3,
      "children": [
        {
          "type": "text",
          "value": "Severity based flush",
          "position": {
            "start": {
              "line": 13,
              "column": 5,
              "offset": 1486
            },
            "end": {
              "line": 13,
              "column": 25,
              "offset": 1506
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 13,
          "column": 1,
          "offset": 1482
        },
        "end": {
          "line": 13,
          "column": 25,
          "offset": 1506
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "You can set the minimum log level that will trigger automatic flush.",
          "position": {
            "start": {
              "line": 14,
              "column": 1,
              "offset": 1507
            },
            "end": {
              "line": 14,
              "column": 69,
              "offset": 1575
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 14,
          "column": 1,
          "offset": 1507
        },
        "end": {
          "line": 14,
          "column": 69,
          "offset": 1575
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "For example, this will trigger flush whenever errors or more severe messages are logged:",
          "position": {
            "start": {
              "line": 16,
              "column": 1,
              "offset": 1577
            },
            "end": {
              "line": 16,
              "column": 89,
              "offset": 1665
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 16,
          "column": 1,
          "offset": 1577
        },
        "end": {
          "line": 16,
          "column": 89,
          "offset": 1665
        }
      }
    },
    {
      "type": "code",
      "lang": "c++",
      "meta": null,
      "value": "my_logger->flush_on(spdlog::level::err); ",
      "position": {
        "start": {
          "line": 17,
          "column": 1,
          "offset": 1666
        },
        "end": {
          "line": 19,
          "column": 4,
          "offset": 1718
        }
      }
    },
    {
      "type": "heading",
      "depth": 3,
      "children": [
        {
          "type": "text",
          "value": "Interval based flush",
          "position": {
            "start": {
              "line": 21,
              "column": 5,
              "offset": 1724
            },
            "end": {
              "line": 21,
              "column": 25,
              "offset": 1744
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 21,
          "column": 1,
          "offset": 1720
        },
        "end": {
          "line": 21,
          "column": 25,
          "offset": 1744
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "spdlog supports setting flush interval. This is implemented by a single worker thread that periodically calls flush() on each logger.",
          "position": {
            "start": {
              "line": 22,
              "column": 1,
              "offset": 1745
            },
            "end": {
              "line": 22,
              "column": 134,
              "offset": 1878
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 22,
          "column": 1,
          "offset": 1745
        },
        "end": {
          "line": 22,
          "column": 134,
          "offset": 1878
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "For example, turn on periodic flush with interval of 5 seconds for all registered loggers:",
          "position": {
            "start": {
              "line": 25,
              "column": 1,
              "offset": 1881
            },
            "end": {
              "line": 25,
              "column": 91,
              "offset": 1971
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 25,
          "column": 1,
          "offset": 1881
        },
        "end": {
          "line": 25,
          "column": 91,
          "offset": 1971
        }
      }
    },
    {
      "type": "code",
      "lang": "c++",
      "meta": null,
      "value": "spdlog::flush_every(std::chrono::seconds(5));",
      "position": {
        "start": {
          "line": 26,
          "column": 1,
          "offset": 1972
        },
        "end": {
          "line": 28,
          "column": 4,
          "offset": 2028
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "strong",
          "children": [
            {
              "type": "text",
              "value": "Note",
              "position": {
                "start": {
                  "line": 30,
                  "column": 3,
                  "offset": 2032
                },
                "end": {
                  "line": 30,
                  "column": 7,
                  "offset": 2036
                }
              }
            }
          ],
          "position": {
            "start": {
              "line": 30,
              "column": 1,
              "offset": 2030
            },
            "end": {
              "line": 30,
              "column": 9,
              "offset": 2038
            }
          }
        },
        {
          "type": "text",
          "value": " Use this only on thread safe loggers, since the periodic flush happens from a different thread.",
          "position": {
            "start": {
              "line": 30,
              "column": 9,
              "offset": 2038
            },
            "end": {
              "line": 30,
              "column": 105,
              "offset": 2134
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 30,
          "column": 1,
          "offset": 2030
        },
        "end": {
          "line": 30,
          "column": 105,
          "offset": 2134
        }
      }
    }
  ],
