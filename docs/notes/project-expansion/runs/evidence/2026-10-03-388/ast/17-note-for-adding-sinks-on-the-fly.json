        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "inlineCode",
          "value": "\"auto sinks = ...\"",
          "position": {
            "start": {
              "line": 12,
              "column": 1,
              "offset": 971
            },
            "end": {
              "line": 12,
              "column": 21,
              "offset": 991
            }
          }
        },
        {
          "type": "text",
          "value": " gives you a copy of the sinks vector so you're not modifying the sinks vector in the logger. The C++ compiler is actually doing what it should with the C++ standard, ",
          "position": {
            "start": {
              "line": 12,
              "column": 21,
              "offset": 991
            },
            "end": {
              "line": 12,
              "column": 188,
              "offset": 1158
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "\"auto var = xyz\"",
          "position": {
            "start": {
              "line": 12,
              "column": 188,
              "offset": 1158
            },
            "end": {
              "line": 12,
              "column": 206,
              "offset": 1176
            }
          }
        },
        {
          "type": "text",
          "value": " is never supposed to give you a reference, it calls the copy constructor of the RHS object.",
          "position": {
            "start": {
              "line": 12,
