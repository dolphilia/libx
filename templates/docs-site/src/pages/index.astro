---
// シンプルなリダイレクト
import { getLegacyProjectConfig, initializeConfig } from '@docs/project-config';
import { generateRedirectUrl } from '@docs/content-utils';

// 設定を初期化
await initializeConfig();
const projectConfig = await getLegacyProjectConfig();

// サーバーサイドでは言語検出できないため、デフォルト言語を使用
const defaultLang = projectConfig.defaultLang;
// GitHub Pagesのベースパス
const baseUrl = projectConfig.baseUrl;

// 実在する最新バージョンの最初のページへリダイレクト
const redirectUrl = await generateRedirectUrl(defaultLang, baseUrl);

// サーバーサイドでリダイレクト
return Astro.redirect(redirectUrl);
---
