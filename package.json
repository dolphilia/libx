{
  "name": "libx",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.10.0"
  },
  "scripts": {
    "dev": "pnpm --filter=./apps/* dev",
    "build": "node scripts/build-integrated.js",
    "build:local": "node scripts/build-integrated.js --local",
    "build:separate": "pnpm --filter=./apps/* build",
    "build:template": "pnpm --filter=template-docs-site build",
    "build:selective": "node scripts/build-selective.js",
    "build:selective:local": "node scripts/build-selective.js --local",
    "preview": "pnpm --filter=./apps/* preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p packages/config/tsconfig.json && tsc --noEmit -p packages/i18n/tsconfig.json && tsc --noEmit -p packages/project-config/tsconfig.json && tsc --noEmit -p packages/content-utils/tsconfig.json && tsc --noEmit -p packages/landing/tsconfig.json && tsc --noEmit -p packages/theme/tsconfig.json && tsc --noEmit -p packages/versioning/tsconfig.typecheck.json",
    "test:unit": "tsc -p config/tsconfig.tests.json && node --test .tmp/tests/tests/unit/*.test.js",
    "test:runtime": "node --test tests/runtime/*.test.js",
    "test:smoke": "node --test tests/smoke/*.test.js",
    "test": "pnpm test:unit && pnpm test:runtime",
    "check:links": "node scripts/check-markdown-links.js",
    "check:integrity": "node scripts/validate-repository-integrity.js && node scripts/validate-category-structure.js && node scripts/sync-docs-layouts.js --check",
    "check:content": "pnpm --recursive --if-present run check:content",
    "check:deployment-assets": "node scripts/check-deployment-assets.js dist",
    "check": "pnpm sync:service-workers && pnpm build:sidebar && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:links && pnpm check:integrity && pnpm check:content && pnpm build:template && pnpm build:separate && pnpm test:smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:service-workers": "node scripts/sync-service-workers.js",
    "sync:layouts": "node scripts/sync-docs-layouts.js",
    "build:sidebar": "node scripts/build-sidebar.js",
    "build:sidebar-selective": "node scripts/build-sidebar-selective.js",
    "build:deploy": "node scripts/build-sidebar.js && node scripts/build-integrated.js",
    "build:deploy-selective": "node scripts/build-sidebar-selective.js && node scripts/build-selective.js",
    "create:project": "node scripts/create-project.js",
    "deploy": "pnpm build -- --confirm && pnpm check:deployment-assets && pnpm deploy:pages",
    "deploy:pages": "wrangler pages deploy dist --project-name libx",
    "perf:comparison": "astro build --root benchmarks/starlight",
    "perf:reader": "node scripts/build-integrated.js --confirm && pnpm perf:comparison && node scripts/performance/measure-reader.js",
    "perf:management": "node scripts/performance/measure-management.js",
    "perf": "pnpm perf:reader && pnpm perf:management && node scripts/performance/create-quality-report.js",
    "awesome:validate-records": "node scripts/importers/awesome/validate-awesome-records.mjs",
    "awesome:lock-root": "node scripts/importers/awesome/lock-awesome-root.mjs",
    "awesome:discover": "node scripts/importers/awesome/discover-awesome-sources.mjs",
    "awesome:inspect": "node scripts/importers/awesome/inspect-awesome-candidates.mjs",
    "awesome:lock-pilot": "node scripts/importers/awesome/lock-awesome-pilot.mjs",
    "awesome:discover-pilot-links": "node scripts/importers/awesome/discover-awesome-pilot-links.mjs",
    "awesome:import": "node scripts/importers/awesome/import-awesome-lists.mjs",
    "awesome:validate-canonical": "node scripts/importers/awesome/validate-awesome-canonical.mjs",
    "awesome:publish": "node scripts/importers/awesome/publish-awesome.mjs",
    "awesome:validate-single-app": "node scripts/importers/awesome/validate-awesome-single-app.mjs",
    "awesome:validate-assets": "node scripts/importers/awesome/validate-awesome-single-app.mjs --assets",
    "awesome:validate-translation": "node scripts/importers/awesome/validate-awesome-translation.mjs",
    "awesome:repair-local-links": "node scripts/importers/awesome/repair-awesome-local-link-destinations.mjs",
    "awesome:translate-generic-prose": "node scripts/importers/awesome/translate-awesome-page-generic-prose.mjs",
    "awesome:validate-translation-complete": "node scripts/importers/awesome/validate-awesome-translation.mjs --require-complete",
    "awesome:audit-machine": "node scripts/importers/awesome/generate-awesome-machine-audit.mjs",
    "awesome:audit-overview-links": "node scripts/importers/awesome/audit-awesome-overview-links.mjs",
    "awesome:audit-missing-license-evidence": "node scripts/importers/awesome/audit-awesome-missing-license-evidence.mjs",
    "awesome:apply-missing-license-review": "node scripts/importers/awesome/apply-awesome-missing-license-review.mjs",
    "awesome:sync-final-review": "node scripts/importers/awesome/sync-awesome-final-review.mjs",
    "awesome:plan-final-review": "node scripts/importers/awesome/generate-awesome-cross-snapshot-review-plan.mjs",
    "awesome:record-automated-review": "node scripts/importers/awesome/record-awesome-automated-final-review.mjs",
    "awesome:generate-source-registry": "node scripts/importers/awesome/generate-awesome-source-registry.mjs",
    "awesome:lock": "node scripts/importers/awesome/lock-awesome-sources.mjs",
    "awesome:verify-license-evidence": "node scripts/importers/awesome/verify-awesome-license-evidence.mjs",
    "awesome:finalize-lock": "node scripts/importers/awesome/finalize-awesome-lock.mjs",
    "awesome:fetch-included": "node scripts/importers/awesome/fetch-awesome-included.mjs",
    "awesome:report-progress": "node scripts/importers/awesome/report-awesome-progress.mjs",
    "awesome:freeze-reconciliation": "node scripts/importers/awesome/freeze-awesome-reconciliation.mjs",
    "awesome:reconcile-canonical": "node scripts/importers/awesome/reconcile-awesome-existing-canonical.mjs",
    "awesome:restore-historical-canonical": "node scripts/importers/awesome/restore-awesome-historical-canonical.mjs",
    "awesome:migrate-historical-review": "node scripts/importers/awesome/migrate-awesome-historical-review.mjs",
    "awesome:translate-metadata-pages": "node scripts/importers/awesome/translate-awesome-metadata-pages.mjs",
    "awesome:generate-content-map": "node scripts/importers/awesome/generate-awesome-content-map.mjs",
    "awesome:generate-external-link-report": "node scripts/importers/awesome/generate-awesome-external-link-report.mjs",
    "awesome:generate-translation-terms": "node scripts/importers/awesome/generate-awesome-translation-terms.mjs",
    "awesome:init-pipeline-status": "node scripts/importers/awesome/initialize-awesome-pipeline-status.mjs",
    "awesome:validate-pipeline-status": "node scripts/importers/awesome/validate-awesome-pipeline-status.mjs",
    "awesome:validate-translation-pilots": "node scripts/importers/awesome/validate-awesome-translation-pilots.mjs",
    "awesome:sync-translation-status": "node scripts/importers/awesome/sync-awesome-translation-status.mjs",
    "awesome:cache-recursive-readmes": "node scripts/importers/awesome/cache-awesome-recursive-readmes.mjs",
    "awesome:discover-depth-two": "node scripts/importers/awesome/discover-awesome-depth-two.mjs",
    "awesome:discover-depth-three": "node scripts/importers/awesome/discover-awesome-depth-three.mjs",
    "awesome:resume-discovery": "node scripts/importers/awesome/resume-awesome-discovery.mjs",
    "awesome:finalize-discovery": "node scripts/importers/awesome/finalize-awesome-discovery.mjs"
  },
  "devDependencies": {
    "@astrojs/starlight": "0.34.8",
    "@types/node": "^20.19.25",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "astro": "5.7.12",
    "astro-eslint-parser": "^0.16.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-astro": "^0.29.0",
    "lighthouse": "12.8.2",
    "parse5": "7.3.0",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^0.14.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.0",
    "remark-parse": "^11.0.0",
    "typescript": "^5.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "wrangler": "4.60.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "glob": "^11.0.2",
    "gray-matter": "^4.0.3"
  }
}
