{
  "name": "libx",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter=./apps/* dev",
    "build": "node scripts/build-integrated.js",
    "build:local": "node scripts/build-integrated.js --local",
    "build:separate": "pnpm --filter=./apps/* build",
    "build:template": "pnpm --filter=template-docs-site build",
    "build:selective": "node scripts/build-selective.js",
    "build:selective:local": "node scripts/build-selective.js --local",
    "preview": "pnpm --filter=./apps/* preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p packages/config/tsconfig.json && tsc --noEmit -p packages/i18n/tsconfig.json && tsc --noEmit -p packages/project-config/tsconfig.json && tsc --noEmit -p packages/content-utils/tsconfig.json && tsc --noEmit -p packages/landing/tsconfig.json && tsc --noEmit -p packages/theme/tsconfig.json && tsc --noEmit -p packages/versioning/tsconfig.typecheck.json",
    "test:unit": "tsc -p config/tsconfig.tests.json && node --test .tmp/tests/tests/unit/*.test.js",
    "test:runtime": "node --test tests/runtime/*.test.js",
    "test:smoke": "node --test tests/smoke/*.test.js",
    "test": "pnpm test:unit && pnpm test:runtime",
    "check": "pnpm sync:service-workers && pnpm build:sidebar && pnpm lint && pnpm typecheck && pnpm test && pnpm build:template && pnpm build:separate && pnpm test:smoke",
    "format": "prettier --write .",
    "sync:service-workers": "node scripts/sync-service-workers.js",
    "build:sidebar": "node scripts/build-sidebar.js",
    "build:sidebar-selective": "node scripts/build-sidebar-selective.js",
    "build:deploy": "node scripts/build-sidebar.js && node scripts/build-integrated.js",
    "build:deploy-selective": "node scripts/build-sidebar-selective.js && node scripts/build-selective.js",
    "create:project": "node scripts/create-project.js",
    "deploy": "pnpm build && pnpm deploy:pages",
    "deploy:pages": "wrangler pages deploy dist --project-name libx"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "astro-eslint-parser": "^0.16.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-astro": "^0.29.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^3.0.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "glob": "^11.0.2",
    "gray-matter": "^4.0.3",
    "unist-util-visit": "^5.0.0"
  }
}
