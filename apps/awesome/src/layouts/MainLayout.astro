---
/**
 * MainLayout - ドキュメントサイトの基本レイアウトコンポーネント
 * Starlightスタイルに基づいたレイアウト
 */
import { DocsHeaderFrame, LanguageSelector, Search, ThemeToggle } from '@docs/ui/components';
import { VersionSelector } from '@docs/versioning/components';
import { getLocaleDirection } from '@docs/i18n/locales';
import type { LocaleKey } from '@docs/i18n/locales';
import '../styles/global.css';
import { getProjectConfig, getDisplayNameAsync } from '@docs/project-config';
import { Icons } from '@docs/ui/components/icons/Icons';
import { buildAvailableLanguagePaths, collectAvailableVersionIds } from '@docs/content-utils';
import localizedRouteManifest from '../generated/awesome-localized-routes.json';

// 定数定義

// インターフェース定義
interface Props {
  /** ページタイトル */
  title: string;
  /** ページ固有の説明 */
  description?: string;
  /** 言語コード */
  lang: LocaleKey;
  /** ドキュメントバージョン */
  version?: string;
  /** サイドバーを表示するか */
  hasSidebar?: boolean;
  /** 目次を表示するか */
  hasToc?: boolean;
  /** バージョンセレクターを表示するか */
  showVersionSelector?: boolean;
  /** パンくずリストを表示するか */
  showBreadcrumb?: boolean;
  /** ページ種別（OG種別と検索エンジン向け指示に使用） */
  pageType?: 'document' | 'index' | 'not-found';
}

// プロパティの取得
const {
  title,
  description,
  lang,
  version = 'v1',
  hasSidebar = false,
  hasToc = false,
  showVersionSelector = true,
  showBreadcrumb = false,
  pageType = 'document',
} = Astro.props;

// プロジェクト設定を読み込み
const projectConfig = await getProjectConfig();
const displayName = await getDisplayNameAsync(lang);
const dir = getLocaleDirection(lang);
const breadcrumbIcon = dir === 'rtl' ? 'chevron-left' : 'chevron-right';
const documentSlugs = localizedRouteManifest.entries.map(
  (entry) => `${entry.version}/${entry.lang}/${entry.slug}`
);

// HTML属性の設定
const htmlDataAttributes: Record<string, string> = { 'data-theme': 'dark' };
if (hasToc) htmlDataAttributes['data-has-toc'] = '';
if (hasSidebar) htmlDataAttributes['data-has-sidebar'] = '';
const htmlAttributes = {
  ...htmlDataAttributes,
  'data-dir': dir,
};

const numBaseSegments = projectConfig.paths.baseUrl.split('/').filter((p) => p.length > 0).length;
const slugSliceIndex = 1 + numBaseSegments + 1 + 1; // 1 (leading empty) + base segments + version segment + lang segment
const currentSlugForSelector = `${lang}/${Astro.url.pathname.split('/').slice(slugSliceIndex).join('/').replace(/\/$/, '')}`; // lang/slug 形式
const relativeSlug = Astro.url.pathname.split('/').slice(slugSliceIndex).filter(Boolean).join('/');
const availableVersionIds = collectAvailableVersionIds({
  documentSlugs,
  language: lang,
  relativeSlug,
});
const availableVersions = projectConfig.versioning.versions.filter((item) =>
  availableVersionIds.has(item.id)
);
const availableLanguagePaths = buildAvailableLanguagePaths({
  documentSlugs,
  supportedLanguages: projectConfig.language.supported,
  displayNames: projectConfig.language.displayNames,
  baseUrl: projectConfig.paths.baseUrl,
  version,
  currentLanguage: lang,
  relativeSlug,
});
const pageDescription =
  description ??
  projectConfig.translations[lang]?.displayDescription ??
  projectConfig.translations[projectConfig.language.default]?.displayDescription ??
  displayName;
const pageTitle = title === displayName ? displayName : `${title} | ${displayName}`;
const siteUrl = projectConfig.paths.siteUrl ?? Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const defaultLanguagePath = availableLanguagePaths.find(
  (item) => item.lang === projectConfig.language.default
);

// ドキュメントトップへの動的リンクを生成
const docTopLink = `${projectConfig.paths.baseUrl}/${version}/${lang}/`;
---

<!doctype html>
<html lang={lang} dir={dir} {...htmlAttributes}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${projectConfig.paths.baseUrl}/favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- ダークモードフラッシュ防止スクリプト -->
    <script is:inline>
      (function () {
        const STORAGE_KEY = 'theme-preference';

        function getThemePreference() {
          if (typeof localStorage !== 'undefined' && localStorage.getItem(STORAGE_KEY)) {
            return localStorage.getItem(STORAGE_KEY);
          }
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        const theme = getThemePreference();
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    {pageType === 'not-found' && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    {
      availableLanguagePaths.map((item) => (
        <link rel="alternate" hreflang={item.lang} href={new URL(item.path, siteUrl).toString()} />
      ))
    }
    {
      defaultLanguagePath && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(defaultLanguagePath.path, siteUrl).toString()}
        />
      )
    }
    <meta property="og:type" content={pageType === 'document' ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <title>{pageTitle}</title>
    <script>
      // Service Workerの登録
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          // サイトのベースURLに応じてsw.jsのパスを解決
          const swPath = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/sw.js`;
          navigator.serviceWorker.register(swPath);
        });
      }
    </script>
  </head>
  <body>
    <div class="page">
      <DocsHeaderFrame dir={dir}>
        <Fragment slot="title">
          {
            showBreadcrumb ? (
              <div class="breadcrumb-title">
                <a href={`/${lang}`} class="site-title">
                  Libx
                </a>
                <svg
                  class="breadcrumb-separator"
                  viewBox="0 0 24 24"
                  set:html={Icons[breadcrumbIcon]}
                />
                <a href={docTopLink} class="doc-title">
                  {displayName}
                </a>
              </div>
            ) : (
              <a href={`/${lang}`} class="site-title">
                {displayName}
              </a>
            )
          }
        </Fragment>
        <Fragment slot="actions">
          <Search baseUrl={projectConfig.paths.baseUrl} version={version} lang={lang} />
          {
            showVersionSelector && version && (
              <div class="version-selector-container">
                <VersionSelector
                  currentVersion={version}
                  versions={availableVersions}
                  basePath={projectConfig.paths.baseUrl}
                  currentSlug={currentSlugForSelector}
                  lang={lang}
                  dir={dir}
                />
              </div>
            )
          }
          <div class="language-selector-container">
            <LanguageSelector currentLang={lang} langPaths={availableLanguagePaths} dir={dir} />
          </div>
          <ThemeToggle lang={lang} />
        </Fragment>
      </DocsHeaderFrame>

      <div class="main-frame">
        <main id="main-content">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
