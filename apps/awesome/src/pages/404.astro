---
import MainLayout from '../layouts/MainLayout.astro';
import { translate } from '@docs/i18n/utils';
import { getProjectConfig } from '@docs/project-config';
import type { LocaleKey } from '@docs/i18n/locales';

const projectConfig = await getProjectConfig();
const lang = projectConfig.language.default as LocaleKey;
const version = projectConfig.versioning.versions[0]?.id ?? 'v1';
const homePath = projectConfig.paths.baseUrl.replace(/\/+$/, '') || '/';
---

<MainLayout
  title={`404 — ${translate('error.notFound', lang)}`}
  description={translate('error.notFoundDescription', lang)}
  lang={lang}
  version={version}
  showVersionSelector={false}
  pageType="not-found"
>
  <section class="not-found" aria-labelledby="not-found-title">
    <p class="status-code" aria-hidden="true">404</p>
    <h1 id="not-found-title">{translate('error.notFound', lang)}</h1>
    <p>{translate('error.notFoundDescription', lang)}</p>
    <a href={homePath}>{translate('error.goHome', lang)}</a>
  </section>
</MainLayout>

<style>
  .not-found {
    max-width: 42rem;
    margin: 0 auto;
    padding: 6rem 1.5rem;
    text-align: center;
  }

  .status-code {
    margin: 0;
    color: var(--sl-color-text-accent);
    font-size: clamp(4rem, 16vw, 8rem);
    font-weight: 800;
    line-height: 1;
  }

  h1 {
    margin-block: 1rem;
  }

  a {
    display: inline-block;
    margin-top: 1rem;
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }
</style>
