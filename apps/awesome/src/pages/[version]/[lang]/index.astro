---
import MainLayout from '../../../layouts/MainLayout.astro';
import { Card } from '@docs/ui/components';
import type { LocaleKey } from '@docs/i18n/locales';
import { translate } from '@docs/i18n/utils';
import { getProjectConfig } from '@docs/project-config';
import routeManifest from '../../../generated/awesome-routes.json';
import localizedRouteManifest from '../../../generated/awesome-localized-routes.json';
import previewStatus from '../../../generated/awesome-preview-status.json';

interface DocEntry {
  title: string;
  description: string;
  slug: string;
  categoryId: string;
  order: number;
}

export async function getStaticPaths() {
  // getStaticPaths内で設定を初期化
  const projectConfig = await getProjectConfig();

  const allVersions = projectConfig.versioning.versions.map((v) => v.id);
  const allLangs = projectConfig.language.supported;

  const paths = [];

  for (const version of allVersions) {
    for (const lang of allLangs) {
      paths.push({
        params: { version, lang },
        props: { lang, version },
      });
    }
  }

  return paths;
}

const { version: versionParam, lang: langParam } = Astro.props;
const lang = (langParam || 'en') as LocaleKey;
const version = versionParam || 'v1';

// 設定を再度初期化（プロパティセクション）
const projectConfig = await getProjectConfig();

// GitHub Pagesのベースパス
const baseUrl = projectConfig.paths.baseUrl;

const docs = localizedRouteManifest.entries.filter(
  (entry) => entry.version === version && entry.lang === lang
) as DocEntry[];

// カテゴリごとにドキュメントを整理
const categories = docs.reduce((acc: Record<string, DocEntry[]>, doc: DocEntry) => {
  if (!acc[doc.categoryId]) {
    acc[doc.categoryId] = [];
  }
  acc[doc.categoryId].push(doc);
  return acc;
}, {});

// カテゴリごとにドキュメントを順序で並べ替え
Object.keys(categories).forEach((category) => {
  categories[category].sort((a: DocEntry, b: DocEntry) => {
    return a.order - b.order;
  });
});

const categoryNames = projectConfig.translations[lang]?.categories ?? {};
const categoryOrder = new Map(
  routeManifest.categories.map((category) => [category.id, category.order])
);
const sortedCategoryIds = Object.keys(categories).sort(
  (left, right) => (categoryOrder.get(left) ?? 999) - (categoryOrder.get(right) ?? 999)
);
---

<MainLayout
  title={`${translate('docs.documentation', lang)} (${version})`}
  lang={lang}
  version={version}
  pageType="index"
>
  <div class="container">
    <h1 class="page-title">{translate('docs.documentation', lang)} - {version}</h1>

    <section class="preview-status" aria-labelledby="preview-status-title">
      <h2 id="preview-status-title">
        {lang === 'ja' ? 'スナップショット' : 'Snapshot'}
      </h2>
      <dl>
        <div>
          <dt>{lang === 'ja' ? 'スナップショットID' : 'Snapshot ID'}</dt><dd>
            {previewStatus.snapshotId}
          </dd>
        </div>
        <div>
          <dt>{lang === 'ja' ? '発見対象' : 'Known sources'}</dt><dd>
            {previewStatus.knownSources}
          </dd>
        </div>
        <div>
          <dt>{lang === 'ja' ? '英語定本' : 'English canonical pages'}</dt><dd>
            {previewStatus.englishCanonicalPages}
          </dd>
        </div>
        <div>
          <dt>
            {lang === 'ja' ? '日本語生成・機械検査済み' : 'Japanese machine-validated pages'}
          </dt><dd>{previewStatus.japaneseMachineValidatedPages}</dd>
        </div>
        <div>
          <dt>{lang === 'ja' ? '除外断片' : 'Excluded fragments'}</dt><dd>
            {previewStatus.excludedFragments}
          </dd>
        </div>
        <div>
          <dt>{lang === 'ja' ? 'メタデータのみ' : 'Metadata-only sources'}</dt><dd>
            {previewStatus.metadataOnlySources}
          </dd>
        </div>
        <div>
          <dt>{lang === 'ja' ? '人手レビュー済み' : 'Human-reviewed items'}</dt><dd>
            {previewStatus.humanReviewedItems}/{previewStatus.totalReviewItems}
          </dd>
        </div>
      </dl>
      <p
        class:list={[
          'review-notice',
          { 'review-complete': previewStatus.contentReviewStatus === 'human-reviewed' },
        ]}
      >
        {
          previewStatus.contentReviewStatus === 'human-reviewed'
            ? lang === 'ja'
              ? '内容の人手レビューは完了しています。'
              : 'Human content review is complete.'
            : lang === 'ja'
              ? '内容の人手レビューは未完了です。'
              : 'Human content review is pending.'
        }
      </p>
    </section>

    <div class="category-list">
      {
        sortedCategoryIds.map((category) => (
          <div class="category-item">
            <h2 class="category-title">{categoryNames[category] || category}</h2>
            <div class="doc-grid">
              {categories[category].map((doc: DocEntry) => (
                <Card title={doc.title} href={`${baseUrl}/${version}/${lang}/${doc.slug}`}>
                  <p class="doc-description">{doc.description}</p>
                </Card>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    {
      sortedCategoryIds.length === 0 && (
        <div class="empty-state">
          <p>{translate('docs.no_documents', lang)}</p>
        </div>
      )
    }
  </div>
</MainLayout>

<style>
  .container {
    max-width: 64rem;
    margin: 0 auto;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 2rem;
  }

  .preview-status {
    margin-bottom: 2rem;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
  }

  .preview-status h2 {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
  }

  .preview-status dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
    margin: 0;
  }

  .preview-status dl div {
    min-width: 0;
  }

  .preview-status dt {
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
  }

  .preview-status dd {
    margin: 0.125rem 0 0;
    font-size: 1.125rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .review-notice {
    margin: 0.875rem 0 0;
    color: var(--sl-color-orange-high);
  }

  .review-notice.review-complete {
    color: var(--sl-color-green-high);
  }

  .category-list {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .category-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .doc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .doc-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .doc-description {
    color: #4b5563;
  }

  :global(.dark) .doc-description {
    color: #9ca3af;
  }

  .empty-state {
    text-align: center;
    padding: 3rem 0;
  }

  .empty-state p {
    color: #4b5563;
  }

  :global(.dark) .empty-state p {
    color: #9ca3af;
  }
</style>
