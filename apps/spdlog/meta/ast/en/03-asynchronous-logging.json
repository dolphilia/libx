    },
    {
      "type": "code",
      "lang": "c++",
      "meta": null,
      "value": "auto tp = std::make_shared<details::thread_pool>(128, 1);\nauto logger = std::make_shared<async_logger>(\"as\", some_sink, tp, async_overflow_policy::overrun_oldest);\n\nauto tp2 = std::make_shared<details::thread_pool>(1024, 4);  // create pool with queue of 1024 slots and 4 backing threads\nauto logger2 = std::make_shared<async_logger>(\"as2\", some_sink, tp2, async_overflow_policy::block);",
      "position": {
