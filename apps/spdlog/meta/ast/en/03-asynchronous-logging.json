          "offset": 5241
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "Please note that with thread pool with multiple workers threads, messages may be reordered after dequeuing.",
          "position": {
            "start": {
              "line": 91,
              "column": 1,
              "offset": 5243
            },
            "end": {
              "line": 91,
              "column": 108,
