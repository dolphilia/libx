    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "By default, spdlog creates a single worker thread which preserves the order of the messages in the queue.",
          "position": {
            "start": {
              "line": 87,
              "column": 1,
              "offset": 4163
            },
            "end": {
              "line": 87,
              "column": 106,
