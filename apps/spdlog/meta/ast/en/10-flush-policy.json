    "canonicalInput": "apps/spdlog/meta/canonical-inputs/10-flush-policy.md",
    "canonicalInputSHA256": "2a3b8cc2b86a1a6a5688903544ea0bb30c289ef61013cbb1a1d280ef5b648c69",
    "trial": "apps/spdlog/src/content/docs/v1-17-0/en/01-guide/10-flush-policy.md",
    "canonicalSHA256": "f73ea05926dfebb007d15870ba09c1a6275b44beccd863626bb29e0924ddbb4e",
    "title": "Flush policy",
    "excluded": [],
    "sourceNote": null
  },
  "children": [
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "By default spdlog lets the underlying libc flush whenever it sees fit in order to achieve good performance. You can override this using the following options:",
          "position": {
            "start": {
              "line": 3,
              "column": 1,
              "offset": 49
            },
            "end": {
              "line": 3,
              "column": 159,
              "offset": 207
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 3,
          "column": 1,
          "offset": 49
        },
        "end": {
          "line": 3,
          "column": 159,
          "offset": 207
        }
      }
    },
    {
      "type": "heading",
      "depth": 3,
      "children": [
        {
          "type": "text",
          "value": "Manual flush",
          "position": {
            "start": {
              "line": 6,
              "column": 5,
              "offset": 214
            },
            "end": {
              "line": 6,
              "column": 17,
              "offset": 226
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 6,
          "column": 1,
          "offset": 210
        },
        "end": {
          "line": 6,
          "column": 17,
          "offset": 226
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "You can use the ",
          "position": {
            "start": {
              "line": 7,
              "column": 1,
              "offset": 227
            },
            "end": {
              "line": 7,
              "column": 17,
              "offset": 243
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "logger->flush()",
          "position": {
            "start": {
              "line": 7,
              "column": 17,
              "offset": 243
            },
            "end": {
              "line": 7,
              "column": 38,
              "offset": 264
            }
          }
        },
        {
          "type": "text",
          "value": " function to instruct a logger to flush its contents. The logger will in turn call the ",
          "position": {
            "start": {
              "line": 7,
              "column": 38,
              "offset": 264
            },
            "end": {
              "line": 7,
              "column": 125,
              "offset": 351
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "flush()",
          "position": {
            "start": {
              "line": 7,
              "column": 125,
              "offset": 351
            },
            "end": {
              "line": 7,
              "column": 138,
              "offset": 364
            }
          }
        },
        {
          "type": "text",
          "value": " function on each of the underlying sinks.",
          "position": {
            "start": {
              "line": 7,
              "column": 138,
              "offset": 364
            },
            "end": {
              "line": 7,
              "column": 180,
              "offset": 406
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 7,
          "column": 1,
          "offset": 227
        },
        "end": {
          "line": 7,
          "column": 180,
          "offset": 406
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "strong",
          "children": [
            {
              "type": "text",
              "value": "Note:",
              "position": {
                "start": {
                  "line": 9,
                  "column": 3,
                  "offset": 410
                },
                "end": {
                  "line": 9,
                  "column": 8,
                  "offset": 415
                }
              }
            }
          ],
          "position": {
            "start": {
              "line": 9,
              "column": 1,
              "offset": 408
            },
            "end": {
              "line": 9,
              "column": 10,
              "offset": 417
            }
          }
        },
        {
          "type": "text",
          "value": " If using an async logger, ",
          "position": {
            "start": {
              "line": 9,
              "column": 10,
              "offset": 417
            },
            "end": {
              "line": 9,
              "column": 37,
              "offset": 444
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "logger->flush()",
          "position": {
            "start": {
              "line": 9,
              "column": 37,
              "offset": 444
            },
            "end": {
              "line": 9,
              "column": 58,
              "offset": 465
            }
          }
        },
        {
          "type": "text",
          "value": " posts a message to the queue requesting the flush operation, so the function returns immediately. This is different from some older versions of spdlog (which would synchronously wait until the message was received and the flush completed). Currently there is no need to explicitly call ",
          "position": {
            "start": {
              "line": 9,
              "column": 58,
              "offset": 465
            },
            "end": {
              "line": 9,
              "column": 345,
              "offset": 752
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "logger->flush()",
          "position": {
            "start": {
              "line": 9,
              "column": 345,
              "offset": 752
            },
            "end": {
              "line": 9,
              "column": 366,
              "offset": 773
            }
          }
        },
        {
          "type": "text",
          "value": "  or ",
          "position": {
            "start": {
              "line": 9,
              "column": 366,
              "offset": 773
            },
            "end": {
              "line": 9,
              "column": 371,
              "offset": 778
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "spdlog::shutdown()",
          "position": {
            "start": {
              "line": 9,
              "column": 371,
              "offset": 778
            },
            "end": {
              "line": 9,
              "column": 395,
              "offset": 802
            }
          }
        },
        {
          "type": "text",
          "value": " before shutting down, it is done automatically at destruction while program exits. However, if you want to flush all the async logger manually before  \"immediately\" exit function such as ",
          "position": {
            "start": {
              "line": 9,
              "column": 395,
              "offset": 802
            },
            "end": {
              "line": 9,
              "column": 583,
              "offset": 990
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "abort()",
          "position": {
            "start": {
              "line": 9,
              "column": 583,
              "offset": 990
            },
            "end": {
              "line": 9,
              "column": 596,
              "offset": 1003
            }
          }
        },
        {
          "type": "text",
          "value": " or ",
          "position": {
            "start": {
              "line": 9,
              "column": 596,
              "offset": 1003
            },
            "end": {
              "line": 9,
              "column": 600,
              "offset": 1007
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "_exit(-1)",
          "position": {
            "start": {
              "line": 9,
              "column": 600,
              "offset": 1007
            },
            "end": {
              "line": 9,
              "column": 615,
              "offset": 1022
            }
          }
        },
        {
          "type": "text",
          "value": ", please call ",
          "position": {
            "start": {
              "line": 9,
              "column": 615,
              "offset": 1022
            },
            "end": {
              "line": 9,
              "column": 629,
              "offset": 1036
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "spdlog::shutdown()",
          "position": {
            "start": {
              "line": 9,
              "column": 629,
              "offset": 1036
            },
            "end": {
              "line": 9,
              "column": 653,
              "offset": 1060
            }
          }
        },
        {
          "type": "text",
          "value": " before those functions.",
          "position": {
            "start": {
              "line": 9,
              "column": 653,
              "offset": 1060
            },
            "end": {
              "line": 9,
              "column": 677,
              "offset": 1084
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 9,
          "column": 1,
          "offset": 408
        },
        "end": {
          "line": 9,
          "column": 677,
          "offset": 1084
        }
      }
    },
    {
      "type": "heading",
      "depth": 3,
      "children": [
        {
          "type": "text",
          "value": "Severity based flush",
          "position": {
            "start": {
              "line": 11,
              "column": 5,
              "offset": 1090
            },
            "end": {
              "line": 11,
              "column": 25,
              "offset": 1110
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 11,
          "column": 1,
          "offset": 1086
        },
        "end": {
          "line": 11,
          "column": 25,
          "offset": 1110
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "You can set the minimum log level that will trigger automatic flush.",
          "position": {
            "start": {
              "line": 12,
              "column": 1,
              "offset": 1111
            },
            "end": {
              "line": 12,
              "column": 69,
              "offset": 1179
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 12,
          "column": 1,
          "offset": 1111
        },
        "end": {
          "line": 12,
          "column": 69,
          "offset": 1179
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "For example, this will trigger flush whenever errors or more severe messages are logged:",
          "position": {
            "start": {
              "line": 14,
              "column": 1,
              "offset": 1181
            },
            "end": {
              "line": 14,
              "column": 89,
              "offset": 1269
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 14,
          "column": 1,
          "offset": 1181
        },
        "end": {
          "line": 14,
          "column": 89,
          "offset": 1269
        }
      }
    },
    {
      "type": "code",
      "lang": "c++",
      "meta": null,
      "value": "my_logger->flush_on(spdlog::level::err); ",
      "position": {
        "start": {
          "line": 15,
          "column": 1,
          "offset": 1270
        },
        "end": {
          "line": 17,
          "column": 4,
          "offset": 1322
        }
      }
    },
    {
      "type": "heading",
      "depth": 3,
      "children": [
        {
          "type": "text",
          "value": "Interval based flush",
          "position": {
            "start": {
              "line": 19,
              "column": 5,
              "offset": 1328
            },
            "end": {
              "line": 19,
              "column": 25,
              "offset": 1348
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 19,
          "column": 1,
          "offset": 1324
        },
        "end": {
          "line": 19,
          "column": 25,
          "offset": 1348
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "spdlog supports setting flush interval. This is implemented by a single worker thread that periodically calls flush() on each logger.",
          "position": {
            "start": {
              "line": 20,
              "column": 1,
              "offset": 1349
            },
            "end": {
              "line": 20,
              "column": 134,
              "offset": 1482
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 20,
          "column": 1,
          "offset": 1349
        },
        "end": {
          "line": 20,
          "column": 134,
          "offset": 1482
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "For example, turn on periodic flush with interval of 5 seconds for all registered loggers:",
          "position": {
            "start": {
              "line": 23,
              "column": 1,
              "offset": 1485
            },
            "end": {
              "line": 23,
              "column": 91,
              "offset": 1575
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 23,
          "column": 1,
          "offset": 1485
        },
        "end": {
          "line": 23,
          "column": 91,
          "offset": 1575
        }
      }
    },
    {
      "type": "code",
      "lang": "c++",
      "meta": null,
      "value": "spdlog::flush_every(std::chrono::seconds(5));",
      "position": {
        "start": {
          "line": 24,
          "column": 1,
          "offset": 1576
        },
        "end": {
          "line": 26,
          "column": 4,
          "offset": 1632
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "strong",
          "children": [
            {
              "type": "text",
              "value": "Note",
              "position": {
                "start": {
                  "line": 28,
                  "column": 3,
                  "offset": 1636
                },
                "end": {
                  "line": 28,
                  "column": 7,
                  "offset": 1640
                }
              }
            }
          ],
          "position": {
            "start": {
              "line": 28,
              "column": 1,
              "offset": 1634
            },
            "end": {
              "line": 28,
              "column": 9,
              "offset": 1642
            }
          }
        },
        {
          "type": "text",
          "value": " Use this only on thread safe loggers, since the periodic flush happens from a different thread.",
          "position": {
            "start": {
              "line": 28,
              "column": 9,
              "offset": 1642
            },
            "end": {
              "line": 28,
              "column": 105,
              "offset": 1738
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 28,
          "column": 1,
          "offset": 1634
        },
        "end": {
          "line": 28,
          "column": 105,
          "offset": 1738
        }
      }
    }
  ],
  "changes": []
}
