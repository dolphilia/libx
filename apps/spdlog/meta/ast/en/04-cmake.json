          "children": [
            {
              "type": "text",
              "value": "https://cmake.org/cmake/help/v3.7/manual/cmake-toolchains.7.html#cross-compiling-for-android",
              "position": {
                "start": {
                  "line": 58,
                  "column": 158,
                  "offset": 2133
                },
                "end": {
                  "line": 58,
                  "column": 250,
                  "offset": 2225
                }
              }
            }
          ],
          "position": {
            "start": {
              "line": 58,
              "column": 158,
              "offset": 2133
            },
            "end": {
              "line": 58,
              "column": 250,
              "offset": 2225
            }
          }
        },
        {
          "type": "text",
          "value": "). Please note that spdlog targets older versions of CMake and this example is a community contribution.",
          "position": {
            "start": {
              "line": 58,
              "column": 250,
              "offset": 2225
            },
            "end": {
              "line": 58,
