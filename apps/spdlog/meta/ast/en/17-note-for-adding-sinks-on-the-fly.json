            }
          }
        },
        {
          "type": "inlineCode",
          "value": "auto&",
          "position": {
            "start": {
              "line": 14,
              "column": 17,
              "offset": 1875
            },
            "end": {
              "line": 14,
              "column": 24,
              "offset": 1882
            }
          }
        },
        {
          "type": "text",
          "value": " or the original sink_ptr type defined in ",
          "position": {
            "start": {
              "line": 14,
              "column": 24,
              "offset": 1882
            },
            "end": {
              "line": 14,
              "column": 66,
