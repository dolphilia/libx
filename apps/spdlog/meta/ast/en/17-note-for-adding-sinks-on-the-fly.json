        {
          "type": "inlineCode",
          "value": "auto&",
          "position": {
            "start": {
              "line": 12,
              "column": 17,
              "offset": 890
            },
            "end": {
              "line": 12,
              "column": 24,
              "offset": 897
            }
          }
        },
        {
          "type": "text",
          "value": " or the original sink_ptr type defined in ",
          "position": {
            "start": {
              "line": 12,
              "column": 24,
              "offset": 897
            },
            "end": {
              "line": 12,
