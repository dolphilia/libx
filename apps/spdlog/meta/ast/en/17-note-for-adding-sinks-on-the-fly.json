        "end": {
          "line": 5,
          "column": 316,
          "offset": 1369
        }
      }
    },
    {
      "type": "code",
      "lang": "cpp",
      "meta": null,
      "value": "auto sinks = log_->sinks();\nsinks.push_back(std::make_shared<spdlog::sinks::callback_sink<std::mutex> >([this](const spdlog::details::log_msg& msg) {this->LogCallback(msg);}));",
      "position": {
        "start": {
          "line": 7,
          "column": 1,
          "offset": 1371
        },
        "end": {
          "line": 10,
          "column": 4,
          "offset": 1558
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "inlineCode",
          "value": "\"auto sinks = ...\"",
          "position": {
            "start": {
              "line": 12,
              "column": 1,
              "offset": 1560
            },
            "end": {
              "line": 12,
              "column": 21,
              "offset": 1580
            }
          }
        },
        {
          "type": "text",
          "value": " gives you a copy of the sinks vector so you're not modifying the sinks vector in the logger. The C++ compiler is actually doing what it should with the C++ standard, ",
          "position": {
            "start": {
              "line": 12,
              "column": 21,
              "offset": 1580
            },
            "end": {
              "line": 12,
              "column": 188,
              "offset": 1747
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "\"auto var = xyz\"",
          "position": {
            "start": {
              "line": 12,
              "column": 188,
              "offset": 1747
            },
            "end": {
              "line": 12,
              "column": 206,
              "offset": 1765
            }
          }
        },
        {
          "type": "text",
          "value": " is never supposed to give you a reference, it calls the copy constructor of the RHS object.",
          "position": {
            "start": {
              "line": 12,
              "column": 206,
              "offset": 1765
            },
            "end": {
              "line": 12,
              "column": 298,
              "offset": 1857
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 12,
          "column": 1,
          "offset": 1560
        },
        "end": {
          "line": 12,
          "column": 298,
          "offset": 1857
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "You need to use ",
          "position": {
