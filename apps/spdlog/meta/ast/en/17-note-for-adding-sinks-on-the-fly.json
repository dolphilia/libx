          "offset": 384
        }
      }
    },
    {
      "type": "code",
      "lang": "cpp",
      "meta": null,
      "value": "auto sinks = log_->sinks();\nsinks.push_back(std::make_shared<spdlog::sinks::callback_sink<std::mutex> >([this](const spdlog::details::log_msg& msg) {this->LogCallback(msg);}));",
      "position": {
        "start": {
          "line": 5,
          "column": 1,
          "offset": 386
        },
        "end": {
          "line": 8,
          "column": 4,
          "offset": 573
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "inlineCode",
          "value": "\"auto sinks = ...\"",
          "position": {
            "start": {
              "line": 10,
              "column": 1,
              "offset": 575
            },
            "end": {
              "line": 10,
              "column": 21,
              "offset": 595
            }
          }
        },
        {
          "type": "text",
          "value": " gives you a copy of the sinks vector so you're not modifying the sinks vector in the logger. The C++ compiler is actually doing what it should with the C++ standard, ",
          "position": {
            "start": {
              "line": 10,
              "column": 21,
              "offset": 595
            },
            "end": {
              "line": 10,
              "column": 188,
              "offset": 762
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "\"auto var = xyz\"",
          "position": {
            "start": {
              "line": 10,
              "column": 188,
              "offset": 762
            },
            "end": {
              "line": 10,
              "column": 206,
              "offset": 780
            }
          }
        },
        {
          "type": "text",
          "value": " is never supposed to give you a reference, it calls the copy constructor of the RHS object.",
          "position": {
            "start": {
              "line": 10,
              "column": 206,
              "offset": 780
            },
            "end": {
              "line": 10,
              "column": 298,
              "offset": 872
            }
          }
        }
      ],
      "position": {
