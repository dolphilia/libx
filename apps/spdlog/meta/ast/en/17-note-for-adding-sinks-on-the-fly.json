            },
            "end": {
              "line": 14,
              "column": 76,
              "offset": 1934
            }
          }
        },
        {
          "type": "text",
          "value": ", but it needs to be a reference to the vector.",
          "position": {
            "start": {
              "line": 14,
              "column": 76,
              "offset": 1934
            },
