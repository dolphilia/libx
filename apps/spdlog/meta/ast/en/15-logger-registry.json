  "children": [
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "spdlog maintains a global (per process) registry of the created loggers.",
          "position": {
            "start": {
              "line": 3,
              "column": 1,
              "offset": 52
            },
            "end": {
              "line": 3,
              "column": 73,
              "offset": 124
            }
          }
        }
      ],
      "position": {
