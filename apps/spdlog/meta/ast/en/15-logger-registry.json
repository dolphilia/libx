          "line": 3,
          "column": 1,
          "offset": 52
        },
        "end": {
          "line": 3,
          "column": 73,
          "offset": 124
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "The purpose is for loggers to be accessed easily from anywhere in the project without passing them around.",
          "position": {
            "start": {
              "line": 5,
              "column": 1,
              "offset": 126
            },
            "end": {
              "line": 5,
              "column": 107,
