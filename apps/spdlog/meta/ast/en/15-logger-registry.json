          "offset": 527
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "Normally  there is no need to register loggers as they are registered automatically for you.",
          "position": {
            "start": {
              "line": 20,
              "column": 1,
              "offset": 528
            },
            "end": {
              "line": 20,
              "column": 93,
