          "offset": 620
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "To register manually created loggers(i.e. not created by the spdlog.h factory functions) use the ",
          "position": {
            "start": {
              "line": 22,
              "column": 1,
              "offset": 622
            },
            "end": {
              "line": 22,
              "column": 98,
              "offset": 719
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "register_logger(std::shared_ptr<logger>)",
          "position": {
            "start": {
              "line": 22,
              "column": 98,
              "offset": 719
            },
            "end": {
              "line": 22,
              "column": 144,
              "offset": 765
            }
          }
        },
        {
          "type": "text",
          "value": " function:",
          "position": {
