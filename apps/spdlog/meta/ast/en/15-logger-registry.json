    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "The \"drop()\" function can be used to remove a logger from the registry.",
          "position": {
            "start": {
              "line": 32,
              "column": 1,
              "offset": 1073
            },
            "end": {
              "line": 32,
              "column": 72,
