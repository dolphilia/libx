        },
        "end": {
          "line": 8,
          "column": 4,
          "offset": 431
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "inlineCode",
          "value": "\"auto sinks = ...\"",
          "position": {
