    "canonicalInput": "apps/spdlog/meta/canonical-inputs/10-flush-policy.md",
    "canonicalInputSHA256": "2a3b8cc2b86a1a6a5688903544ea0bb30c289ef61013cbb1a1d280ef5b648c69",
    "trial": "apps/spdlog/src/content/docs/v1-17-0/en/01-guide/10-flush-policy.md",
    "canonicalSHA256": "f73ea05926dfebb007d15870ba09c1a6275b44beccd863626bb29e0924ddbb4e",
    "title": "Flush policy",
    "excluded": [],
    "sourceNote": null
  },
  "children": [
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "デフォルトでは、spdlogは良好な性能を得るため、基盤となるlibcの判断にフラッシュのタイミングを任せます。次の方法で、この動作を変更できます。",
          "position": {
            "start": {
              "line": 3,
              "column": 1,
              "offset": 49
            },
            "end": {
              "line": 3,
              "column": 75,
              "offset": 123
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 3,
          "column": 1,
          "offset": 49
        },
        "end": {
          "line": 3,
          "column": 75,
          "offset": 123
        }
      }
    },
    {
      "type": "heading",
      "depth": 3,
      "children": [
        {
          "type": "text",
          "value": "手動フラッシュ",
          "position": {
            "start": {
              "line": 5,
              "column": 5,
              "offset": 129
            },
            "end": {
              "line": 5,
              "column": 12,
              "offset": 136
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 5,
          "column": 1,
          "offset": 125
        },
        "end": {
          "line": 5,
          "column": 12,
          "offset": 136
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "inlineCode",
          "value": "logger->flush()",
          "position": {
            "start": {
              "line": 6,
              "column": 1,
              "offset": 137
            },
            "end": {
              "line": 6,
              "column": 18,
              "offset": 154
            }
          }
        },
        {
          "type": "text",
          "value": " 関数を使うと、ロガーに内容のフラッシュを指示できます。ロガーは、基盤となる各sinkの ",
          "position": {
            "start": {
              "line": 6,
              "column": 18,
              "offset": 154
            },
            "end": {
              "line": 6,
              "column": 63,
              "offset": 199
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "flush()",
          "position": {
            "start": {
              "line": 6,
              "column": 63,
              "offset": 199
            },
            "end": {
              "line": 6,
              "column": 72,
              "offset": 208
            }
          }
        },
        {
          "type": "text",
          "value": " 関数を呼び出します。",
          "position": {
            "start": {
              "line": 6,
              "column": 72,
              "offset": 208
            },
            "end": {
              "line": 6,
              "column": 83,
              "offset": 219
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 6,
          "column": 1,
          "offset": 137
        },
        "end": {
          "line": 6,
          "column": 83,
          "offset": 219
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "strong",
          "children": [
            {
              "type": "text",
              "value": "注意：",
              "position": {
                "start": {
                  "line": 8,
                  "column": 3,
                  "offset": 223
                },
                "end": {
                  "line": 8,
                  "column": 6,
                  "offset": 226
                }
              }
            }
          ],
          "position": {
            "start": {
              "line": 8,
              "column": 1,
              "offset": 221
            },
            "end": {
              "line": 8,
              "column": 8,
              "offset": 228
            }
          }
        },
        {
          "type": "text",
          "value": " 非同期ロガーの場合、",
          "position": {
            "start": {
              "line": 8,
              "column": 8,
              "offset": 228
            },
            "end": {
              "line": 8,
              "column": 19,
              "offset": 239
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "logger->flush()",
          "position": {
            "start": {
              "line": 8,
              "column": 19,
              "offset": 239
            },
            "end": {
              "line": 8,
              "column": 36,
              "offset": 256
            }
          }
        },
        {
          "type": "text",
          "value": " はフラッシュ操作を要求するメッセージをキューへ送り、すぐに戻ります。この動作は、メッセージが受信されてフラッシュが完了するまで同期的に待っていた、spdlogの一部の旧版とは異なります。現在は、終了前に ",
          "position": {
            "start": {
              "line": 8,
              "column": 36,
              "offset": 256
            },
            "end": {
              "line": 8,
              "column": 139,
              "offset": 359
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "logger->flush()",
          "position": {
            "start": {
              "line": 8,
              "column": 139,
              "offset": 359
            },
            "end": {
              "line": 8,
              "column": 156,
              "offset": 376
            }
          }
        },
        {
          "type": "text",
          "value": " や ",
          "position": {
            "start": {
              "line": 8,
              "column": 156,
              "offset": 376
            },
            "end": {
              "line": 8,
              "column": 159,
              "offset": 379
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "spdlog::shutdown()",
          "position": {
            "start": {
              "line": 8,
              "column": 159,
              "offset": 379
            },
            "end": {
              "line": 8,
              "column": 179,
              "offset": 399
            }
          }
        },
        {
          "type": "text",
          "value": " を明示的に呼び出す必要はありません。プログラムの終了に伴う破棄時に、自動的に行われます。ただし、",
          "position": {
            "start": {
              "line": 8,
              "column": 179,
              "offset": 399
            },
            "end": {
              "line": 8,
              "column": 228,
              "offset": 448
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "abort()",
          "position": {
            "start": {
              "line": 8,
              "column": 228,
              "offset": 448
            },
            "end": {
              "line": 8,
              "column": 237,
              "offset": 457
            }
          }
        },
        {
          "type": "text",
          "value": " や ",
          "position": {
            "start": {
              "line": 8,
              "column": 237,
              "offset": 457
            },
            "end": {
              "line": 8,
              "column": 240,
              "offset": 460
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "_exit(-1)",
          "position": {
            "start": {
              "line": 8,
              "column": 240,
              "offset": 460
            },
            "end": {
              "line": 8,
              "column": 251,
              "offset": 471
            }
          }
        },
        {
          "type": "text",
          "value": " のように「即座に」終了する関数の前に、すべての非同期ロガーを手動でフラッシュしたい場合は、それらの関数の前に ",
          "position": {
            "start": {
              "line": 8,
              "column": 251,
              "offset": 471
            },
            "end": {
              "line": 8,
              "column": 307,
              "offset": 527
            }
          }
        },
        {
          "type": "inlineCode",
          "value": "spdlog::shutdown()",
          "position": {
            "start": {
              "line": 8,
              "column": 307,
              "offset": 527
            },
            "end": {
              "line": 8,
              "column": 327,
              "offset": 547
            }
          }
        },
        {
          "type": "text",
          "value": " を呼び出してください。",
          "position": {
            "start": {
              "line": 8,
              "column": 327,
              "offset": 547
            },
            "end": {
              "line": 8,
              "column": 339,
              "offset": 559
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 8,
          "column": 1,
          "offset": 221
        },
        "end": {
          "line": 8,
          "column": 339,
          "offset": 559
        }
      }
    },
    {
      "type": "heading",
      "depth": 3,
      "children": [
        {
          "type": "text",
          "value": "重大度に基づくフラッシュ",
          "position": {
            "start": {
              "line": 10,
              "column": 5,
              "offset": 565
            },
            "end": {
              "line": 10,
              "column": 17,
              "offset": 577
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 10,
          "column": 1,
          "offset": 561
        },
        "end": {
          "line": 10,
          "column": 17,
          "offset": 577
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "自動フラッシュを引き起こす最小ログレベルを設定できます。",
          "position": {
            "start": {
              "line": 11,
              "column": 1,
              "offset": 578
            },
            "end": {
              "line": 11,
              "column": 29,
              "offset": 606
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 11,
          "column": 1,
          "offset": 578
        },
        "end": {
          "line": 11,
          "column": 29,
          "offset": 606
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "たとえば、次の設定では、エラーまたはそれより重大なメッセージが記録されるたびにフラッシュします。",
          "position": {
            "start": {
              "line": 13,
              "column": 1,
              "offset": 608
            },
            "end": {
              "line": 13,
              "column": 49,
              "offset": 656
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 13,
          "column": 1,
          "offset": 608
        },
        "end": {
          "line": 13,
          "column": 49,
          "offset": 656
        }
      }
    },
    {
      "type": "code",
      "lang": "c++",
      "meta": null,
      "value": "my_logger->flush_on(spdlog::level::err); ",
      "position": {
        "start": {
          "line": 14,
          "column": 1,
          "offset": 657
        },
        "end": {
          "line": 16,
          "column": 4,
          "offset": 709
        }
      }
    },
    {
      "type": "heading",
      "depth": 3,
      "children": [
        {
          "type": "text",
          "value": "時間間隔に基づくフラッシュ",
          "position": {
            "start": {
              "line": 18,
              "column": 5,
              "offset": 715
            },
            "end": {
              "line": 18,
              "column": 18,
              "offset": 728
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 18,
          "column": 1,
          "offset": 711
        },
        "end": {
          "line": 18,
          "column": 18,
          "offset": 728
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "spdlogでは、フラッシュの間隔を設定できます。単一のワーカースレッドが、各ロガーのflush()を定期的に呼び出すことで実装しています。",
          "position": {
            "start": {
              "line": 19,
              "column": 1,
              "offset": 729
            },
            "end": {
              "line": 19,
              "column": 71,
              "offset": 799
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 19,
          "column": 1,
          "offset": 729
        },
        "end": {
          "line": 19,
          "column": 71,
          "offset": 799
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "たとえば、登録済みのすべてのロガーについて、5秒間隔の定期フラッシュを有効にします。",
          "position": {
            "start": {
              "line": 21,
              "column": 1,
              "offset": 801
            },
            "end": {
              "line": 21,
              "column": 43,
              "offset": 843
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 21,
          "column": 1,
          "offset": 801
        },
        "end": {
          "line": 21,
          "column": 43,
          "offset": 843
        }
      }
    },
    {
      "type": "code",
      "lang": "c++",
      "meta": null,
      "value": "spdlog::flush_every(std::chrono::seconds(5));",
      "position": {
        "start": {
          "line": 22,
          "column": 1,
          "offset": 844
        },
        "end": {
          "line": 24,
          "column": 4,
          "offset": 900
        }
      }
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "strong",
          "children": [
            {
              "type": "text",
              "value": "注意：",
              "position": {
                "start": {
                  "line": 26,
                  "column": 3,
                  "offset": 904
                },
                "end": {
                  "line": 26,
                  "column": 6,
                  "offset": 907
                }
              }
            }
          ],
          "position": {
            "start": {
              "line": 26,
              "column": 1,
              "offset": 902
            },
            "end": {
              "line": 26,
              "column": 8,
              "offset": 909
            }
          }
        },
        {
          "type": "text",
          "value": " 定期フラッシュは別のスレッドから行われるため、スレッドセーフなロガーに対してのみ使用してください。",
          "position": {
            "start": {
              "line": 26,
              "column": 8,
              "offset": 909
            },
            "end": {
              "line": 26,
              "column": 58,
              "offset": 959
            }
          }
        }
      ],
      "position": {
        "start": {
          "line": 26,
          "column": 1,
          "offset": 902
        },
        "end": {
          "line": 26,
          "column": 58,
          "offset": 959
        }
      }
    }
  ],
  "changes": []
}
