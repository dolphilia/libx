          "checked": null,
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "レベル名をカスタマイズするには、コメントを外します（例：\"MY TRACE\"。",
                  "position": {
                    "start": {
                      "line": 19,
