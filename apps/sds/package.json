{
  "name": "apps-sds",
  "private": true,
  "description": "Documentation site for sds",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "prebuild": "libx-docs-prepare --projects=sds",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:content": "node check-content.mjs",
    "check:rendered": "node check-content.mjs --rendered",
    "import:canonical": "python3 ../../scripts/importers/import-sds-2.0.0.py --output=../../.tmp/sds-regenerated"
  },
  "dependencies": {
    "@docs/config": "workspace:*",
    "@docs/content-utils": "workspace:*",
    "@docs/i18n": "workspace:*",
    "@docs/project-config": "workspace:*",
    "@docs/theme": "workspace:*",
    "@docs/ui": "workspace:*",
    "@docs/versioning": "workspace:*",
    "astro": "^5.7.12",
    "shiki": "^3.4.0",
    "unist-util-visit": "^5.0.0"
  }
}
