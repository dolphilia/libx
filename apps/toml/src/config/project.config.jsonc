{
  "paths": {
    "baseUrlPrefix": "/docs",
    "projectSlug": "toml",
    "siteUrl": "https://libx.dev"
  },
  // 言語設定（対応言語・デフォルト・表示名）
  "language": {
    "default": "en",
    "supported": ["en", "ja"],
    "displayNames": {
      "en": "English",
      "ja": "日本語"
    }
  },
  // 各言語の表示情報とカテゴリ名
  "translations": {
    "en": {
      "displayName": "TOML Documentation",
      "displayDescription": "TOML 1.1.0 specification and ABNF grammar",
      "categories": {
        "specification": "Specification",
        "reference": "Reference",
        "license": "License"
      }
    },
    "ja": {
      "displayName": "TOML ドキュメント",
      "displayDescription": "TOML 1.1.0仕様全文とABNF文法",
      "categories": {
        "specification": "仕様",
        "reference": "リファレンス",
        "license": "ライセンス"
      }
    }
  },
  // バージョン管理
  "versioning": {
    "versions": [
      {
        "id": "v1-1-0",
        "name": "TOML 1.1.0",
        "date": "2025-12-18T00:00:00.000Z",
        "isLatest": true
      }
    ]
  },
  // ライセンス情報
  "licensing": {
    "defaultSource": "toml-site-1.1.0",
    "showAttribution": true,
    "sourceLanguage": "en",
    "sources": [
      {
        "id": "toml-site-1.1.0",
        "name": "TOML 1.1.0 Published Specification",
        "author": "Tom Preston-Werner, Pradyun Gedam et al. (TOML authors)",
        "license": "MIT",
        "licenseUrl": "https://github.com/toml-lang/toml.io/blob/b950d4929980ee66f2e77bfe421e725ddffbeb69/LICENSE",
        "sourceUrl": "https://toml.io/en/v1.1.0"
      },
      {
        "id": "toml-grammar-1.1.0",
        "name": "TOML 1.1.0 ABNF Grammar",
        "author": "Tom Preston-Werner and TOML contributors",
        "license": "MIT",
        "licenseUrl": "https://github.com/toml-lang/toml/blob/bcbbd1c1f03473ffe97b8bf26a0fc945efe2b4a1/LICENSE",
        "sourceUrl": "https://github.com/toml-lang/toml/blob/bcbbd1c1f03473ffe97b8bf26a0fc945efe2b4a1/toml.abnf"
      }
    ]
  }
}
