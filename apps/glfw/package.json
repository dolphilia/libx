{
  "name": "apps-glfw",
  "private": true,
  "description": "Documentation site for glfw",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "prebuild": "node ../../scripts/build-sidebar-selective.js --projects=glfw && node ../../scripts/build-search-index.js --project=glfw && node ../../scripts/sync-service-workers.js --project=glfw",
    "dev": "astro dev",
    "build": "astro build",
    "check:content": "node ../../scripts/importers/import-glfw-3.5.1.mjs --check && node ../../scripts/validate-translated-content.mjs --project=glfw --version=v3-5-1 --target=ja --identifier-prefixes=GLFW,glfw,Vk,VK_",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@docs/config": "workspace:*",
    "@docs/content-utils": "workspace:*",
    "@docs/i18n": "workspace:*",
    "@docs/project-config": "workspace:*",
    "@docs/theme": "workspace:*",
    "@docs/ui": "workspace:*",
    "@docs/versioning": "workspace:*",
    "astro": "^5.7.12",
    "shiki": "^3.4.0",
    "unist-util-visit": "^5.0.0"
  }
}
