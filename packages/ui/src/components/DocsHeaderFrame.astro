---
interface Props {
  dir?: 'ltr' | 'rtl';
}

const { dir = 'ltr' } = Astro.props;
---

<header class="header" dir={dir}>
  <div class="header-container">
    <div class="header-content">
      <div class="title-wrapper"><slot name="title" /></div>
      <div class="print:hidden right-group"><slot name="actions" /></div>
    </div>
  </div>
</header>
