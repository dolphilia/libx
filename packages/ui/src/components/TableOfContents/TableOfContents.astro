---
import TableOfContentsList from './TableOfContentsList.astro';

import { translate } from '@docs/i18n/utils';
import type { LocaleKey } from '@docs/i18n/locales';

export interface TocItem {
  depth: number;
  text: string;
  slug: string;
  children: TocItem[];
}

interface Props {
  /**
   * 目次の項目
   */
  headings: TocItem[];

  /**
   * 表示する最小の見出しレベル
   * @default 2
   */
  minLevel?: number;

  /**
   * 表示する最大の見出しレベル
   * @default 3
   */
  maxLevel?: number;

  /**
   * 言語キー
   */
  lang?: LocaleKey;

  /**
   * モバイル表示かどうか
   * @default false
   */
  isMobile?: boolean;
  /**
   * 文字方向
   * @default 'ltr'
   */
  dir?: 'ltr' | 'rtl';
}

const {
  headings,
  minLevel = 2,
  maxLevel = 3,
  lang = 'en' as LocaleKey,
  isMobile = false,
  dir = 'ltr',
} = Astro.props;

// 指定されたレベル範囲内の見出しのみをフィルタリング
const filteredHeadings = headings.filter(
  (heading) => heading.depth >= minLevel && heading.depth <= maxLevel
);

// 翻訳キー
const TOC_TITLE = 'docs.onThisPage';
const headingId = isMobile ? 'starlight-toc-heading-mobile' : 'starlight-toc-heading';
---

{
  filteredHeadings.length > 0 && (
    <starlight-toc
      data-min-h={minLevel}
      data-max-h={maxLevel}
      class:list={{ 'starlight-toc--mobile': isMobile }}
      dir={dir}
    >
      <div class="starlight-toc-wrapper">
        <nav aria-labelledby={headingId}>
          <h3 id={headingId} class="starlight-toc-heading">
            {translate(TOC_TITLE, lang)}
          </h3>
          <div class="starlight-toc-list">
            <TableOfContentsList toc={filteredHeadings} isMobile={isMobile} />
          </div>
        </nav>
      </div>
    </starlight-toc>
  )
}

<script>
  class StarlightTOC extends HTMLElement {
    activeHeading: HTMLAnchorElement | null = null;
    observer: IntersectionObserver | null = null;
    visibleHeadings: Map<Element, IntersectionObserverEntry> = new Map();

    connectedCallback() {
      // 見出し要素を取得
      const minLevel = parseInt(this.dataset.minH || '2');
      const maxLevel = parseInt(this.dataset.maxH || '3');
      const headingSelectors = Array.from(
        { length: maxLevel - minLevel + 1 },
        (_, i) => `h${minLevel + i}`
      ).join(',');

      const headings = Array.from(
        document.querySelectorAll(headingSelectors)
      ) as HTMLHeadingElement[];

      // 目次内のリンクを取得
      const links = Array.from(this.querySelectorAll('a')) as HTMLAnchorElement[];

      const activate = (heading: HTMLHeadingElement | undefined) => {
        const next = heading
          ? links.find((link) => link.getAttribute('href') === `#${heading.id}`) || null
          : null;
        if (next === this.activeHeading) return;
        this.activeHeading?.removeAttribute('aria-current');
        this.activeHeading?.classList.remove('active');
        next?.setAttribute('aria-current', 'true');
        next?.classList.add('active');
        this.activeHeading = next;
      };

      this.observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) this.visibleHeadings.set(entry.target, entry);
          const visible = headings.find(
            (heading) => this.visibleHeadings.get(heading)?.isIntersecting
          );
          if (visible) activate(visible);
        },
        { rootMargin: '-80px 0px -70% 0px', threshold: [0, 1] }
      );
      headings.forEach((heading) => this.observer?.observe(heading));
      activate(headings[0]);
    }

    disconnectedCallback() {
      this.observer?.disconnect();
      this.observer = null;
      this.visibleHeadings.clear();
    }
  }

  // カスタム要素を登録
  if (!customElements.get('starlight-toc')) {
    customElements.define('starlight-toc', StarlightTOC);
  }
</script>

<style>
  starlight-toc {
    display: block;
    width: 100%;
  }

  .starlight-toc-wrapper {
    width: 100%;
    padding: 0;
  }

  starlight-toc:not(.starlight-toc--mobile) nav {
    border-inline-start: 1px solid var(--color-border-light);
    padding-inline-start: 0.75rem;
  }

  .starlight-toc-heading {
    font-size: var(--sl-text-sm);
    font-weight: 800;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
    margin-bottom: 1.5rem;
    letter-spacing: 0.05em;
  }

  /* モバイル表示用スタイル */
  .starlight-toc--mobile {
    position: sticky;
    top: var(--sl-nav-height);
    z-index: var(--sl-z-index-toc);
    max-height: calc(100vh - var(--sl-nav-height));
    overflow-y: auto;
    background-color: var(--sl-color-bg);
    overscroll-behavior: contain;
  }

  .starlight-toc--mobile .starlight-toc-wrapper {
    padding: 0;
  }

  .starlight-toc--mobile .starlight-toc-heading {
    font-size: var(--sl-text-base);
  }

  /* デスクトップ表示 */
  @media (min-width: 50rem) {
    starlight-toc {
      display: block;
      position: sticky;
      top: var(--sl-nav-height);
      max-height: calc(100vh - var(--sl-nav-height));
      height: 100%;
      overflow-y: auto;
    }

    .starlight-toc-wrapper {
      width: 100%;
      padding: 0;
    }
  }
</style>
