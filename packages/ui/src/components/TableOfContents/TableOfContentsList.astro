---
import type { TocItem } from './TableOfContents.astro';

interface Props {
  /**
   * 目次の項目
   */
  toc: TocItem[];

  /**
   * 階層の深さ
   * @default 0
   */
  depth?: number;

  /**
   * モバイル表示かどうか
   * @default false
   */
  isMobile?: boolean;
}

const { toc, depth = 0, isMobile = false } = Astro.props;
---

<ul class:list={['starlight-toc__list', { 'starlight-toc__list--mobile': isMobile }]}>
  {
    toc.map((heading) => (
      <li class="starlight-toc__item">
        <a
          class="starlight-toc__link"
          href={'#' + heading.slug}
          data-depth={depth}
          data-heading-level={heading.depth}
        >
          <span>{heading.text}</span>
        </a>
        {heading.children.length > 0 && (
          <Astro.self toc={heading.children} depth={depth + 1} isMobile={isMobile} />
        )}
      </li>
    ))
  }
</ul>

<style>
  .starlight-toc__list {
    padding: 0;
    list-style: none;
    margin: 0;
  }

  .starlight-toc__item {
    margin: 0;
  }

  .starlight-toc__link {
    display: block;
    border-radius: 0.25rem;
    padding-block: 0.3rem;
    padding-inline: 0.5rem;
    line-height: 1.35;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    overflow-wrap: anywhere;
    text-wrap: pretty;
    transition:
      background-color 0.15s ease-in-out,
      color 0.15s ease-in-out;
  }

  .starlight-toc__link[data-heading-level='2'] {
    padding-inline-start: 0;
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .starlight-toc__link[data-heading-level='3'] {
    padding-inline-start: 1rem;
    font-size: 0.85rem;
  }

  .starlight-toc__item > .starlight-toc__list {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .starlight-toc__link:hover {
    color: var(--sl-color-white, var(--color-text-primary));
    background-color: var(--sl-color-gray-7, rgba(255, 255, 255, 0.05));
  }

  .starlight-toc__link:focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: var(--sl-outline-offset-inside);
  }

  .starlight-toc__link.active,
  .starlight-toc__link[aria-current='true'] {
    color: var(--color-brand-primary);
    background-color: transparent;
    font-weight: 600;
  }

  /* モバイル表示用スタイル */
  .starlight-toc__list--mobile {
    width: 100%;
  }

  .starlight-toc__list--mobile .starlight-toc__link {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.55rem;
    padding-inline: 0.75rem;
    border-top: 1px solid var(--color-border-light);
    border-radius: 0;
    color: var(--color-text-primary);
    font-size: var(--sl-text-base);
    text-decoration: none;
    outline-offset: var(--sl-outline-offset-inside);
  }

  .starlight-toc__list--mobile .starlight-toc__link[data-heading-level='2'] {
    font-weight: 700;
  }

  .starlight-toc__list--mobile .starlight-toc__link[data-heading-level='3'] {
    padding-inline-start: 1.5rem;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .starlight-toc__list--mobile:first-child
    > .starlight-toc__item:first-child
    > .starlight-toc__link {
    border-top: 0;
  }

  .starlight-toc__list--mobile .starlight-toc__link.active,
  .starlight-toc__list--mobile .starlight-toc__link[aria-current='true'],
  .starlight-toc__list--mobile .starlight-toc__link[aria-current='true']:hover,
  .starlight-toc__list--mobile .starlight-toc__link[aria-current='true']:focus {
    color: var(--color-brand-primary);
    background-color: unset;
  }

  .starlight-toc__list--mobile .starlight-toc__link.active::after,
  .starlight-toc__list--mobile .starlight-toc__link[aria-current='true']::after {
    content: '';
    width: 1rem;
    height: 1rem;
    background-color: var(--color-brand-primary);
    /* チェックマークSVGアイコン */
    -webkit-mask-image: url('data:image/svg+xml;base64,');
    mask-image: url('data:image/svg+xml;base64,');
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    flex-shrink: 0;
  }
</style>
