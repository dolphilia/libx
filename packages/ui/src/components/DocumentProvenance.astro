---
import type { LocaleKey } from '@docs/i18n/locales';
import { getLicenseTemplate, translate } from '@docs/i18n/utils';
import type { LicenseSource, ProjectConfig } from '@docs/project-config';

interface Props {
  projectConfig: ProjectConfig;
  lang: LocaleKey;
  version: string;
  licenseSource?: string;
  documentContext?: Array<{
    kind: 'source' | 'editorial';
    html: string;
    context?: { anchor: string; label: string };
  }>;
}

const { projectConfig, lang, version, licenseSource, documentContext = [] } = Astro.props;
const licensing = projectConfig.licensing;
const sourceId = licenseSource ?? licensing.defaultSource;
const source = licensing.sources.find((item: LicenseSource) => item.id === sourceId);

if (!source) {
  throw new Error(`Document provenance source not found: ${sourceId}`);
}

const versionName =
  projectConfig.versioning.versions.find((item) => item.id === version)?.name ?? version;
const isCanonical = lang === licensing.sourceLanguage;
const attributionText = getLicenseTemplate(
  {
    name: source.name,
    title: source.name,
    author: source.author,
    license: source.license,
    licenseUrl: source.licenseUrl,
    sourceUrl: source.sourceUrl,
  },
  lang,
  projectConfig
);
---

{
  (licensing.showAttribution || documentContext.length > 0) && (
    <aside class="document-provenance" aria-labelledby="document-provenance-title">
      <div class="provenance-header">
        <h2 id="document-provenance-title">
          {documentContext.length > 0 || Astro.slots.has('default')
            ? lang === 'ja'
              ? '出典・編集注記'
              : 'Source and editorial notes'
            : translate('sourceStatus.title', lang)}
        </h2>
        <span class="provenance-status">
          {translate(isCanonical ? 'sourceStatus.canonical' : 'sourceStatus.translation', lang)}
        </span>
      </div>

      <p class="attribution-text">{attributionText}</p>
      {source.copyrightNotice && <p class="attribution-text">{source.copyrightNotice}</p>}
      {source.provenanceNotes?.map((note) => (
        <p class="attribution-text">{lang === 'ja' ? note.ja : note.en}</p>
      ))}

      <dl class="provenance-metadata">
        <div>
          <dt>{translate('sourceStatus.source', lang)}</dt>
          <dd>{source.name}</dd>
        </div>
        <div>
          <dt>{translate('sourceStatus.version', lang)}</dt>
          <dd>{versionName}</dd>
        </div>
        <div>
          <dt>{translate('license.links.license', lang)}</dt>
          <dd>{source.license}</dd>
        </div>
      </dl>

      <div class="provenance-links">
        <a href={source.sourceUrl} target="_blank" rel="noopener">
          {translate('sourceStatus.original', lang)}
        </a>
        <a href={source.licenseUrl} target="_blank" rel="noopener">
          {source.license} {translate('license.links.license', lang)}
        </a>
        {source.attributionLinks?.map((link) => (
          <a href={link.url} target="_blank" rel="noopener">
            {lang === 'ja' ? link.label.ja : link.label.en}
          </a>
        ))}
      </div>
      {documentContext.some((note) => note.kind === 'editorial') && (
        <p class="attribution-text">
          {lang === 'ja'
            ? '編集注記中の位置表現（上・下など）は、移動前の本文中の位置を指します。対象箇所のリンクから本文を確認できます。'
            : 'Positional wording in editorial notes (above or below) refers to the original location in the document. Follow the section link to read it in context.'}
        </p>
      )}
      {documentContext.map((note) => (
        <details class="page-document-context" data-context-kind={note.kind}>
          <summary>
            {note.kind === 'source'
              ? lang === 'ja'
                ? 'ページの出典詳細'
                : 'Page source details'
              : lang === 'ja'
                ? '原文に関する編集注記'
                : 'Editorial notes on the source'}
            {note.context && ` — ${note.context.label}`}
          </summary>
          {note.context && (
            <p>
              {lang === 'ja' ? '対象箇所：' : 'Section: '}
              <a href={`#${note.context.anchor}`}>{note.context.label}</a>
            </p>
          )}
          <div class="sl-markdown-content" set:html={note.html} />
        </details>
      ))}
      <slot />
    </aside>
  )
}

<style>
  .document-provenance {
    margin-block-start: 3rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  summary {
    cursor: pointer;
    color: var(--sl-color-white);
    font-weight: 600;
  }
  details[open] > summary {
    margin-block-end: 1rem;
  }
  .page-document-context {
    margin-block-start: 1rem;
    overflow-wrap: anywhere;
  }
  @media print {
    details::details-content {
      content-visibility: visible;
    }
  }

  .provenance-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 0.75rem;
  }

  .provenance-header h2 {
    margin: 0;
    color: var(--sl-color-white);
    font-size: var(--sl-text-base);
  }

  .provenance-status {
    flex-shrink: 0;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    color: var(--sl-color-gray-1);
    font-size: var(--sl-text-xs);
  }

  .attribution-text {
    margin: 0 0 1rem;
    color: var(--sl-color-gray-1);
    line-height: 1.5;
  }

  .provenance-metadata {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem 1.5rem;
    margin: 0 0 1rem;
  }

  .provenance-metadata > div {
    min-width: 0;
  }

  .provenance-metadata dt {
    margin-block-end: 0.125rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }

  .provenance-metadata dd {
    margin: 0;
    color: var(--sl-color-gray-1);
    overflow-wrap: anywhere;
  }

  .provenance-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .provenance-links a {
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-xs);
  }

  .provenance-links a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  @media (max-width: 40rem) {
    .provenance-header {
      align-items: flex-start;
    }

    .provenance-metadata {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media print {
    .provenance-links a::after {
      content: ' (' attr(href) ')';
    }
  }
</style>
